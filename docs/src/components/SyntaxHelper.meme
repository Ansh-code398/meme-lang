pakad TYPE_HI_TO_EN = {
    "ank": "int",
    "sankhya": "int",
    "point": "float",
    "dashamlav": "float",
    "bol": "str",
    "shabd": "str",
    "sach": "bool"
};

jugaad isWordChar(ch) {
    pakad c = code_de(ch);
    ye_le (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
}

jugaad isDigitChar(ch) {
    pakad c = code_de(ch);
    ye_le c >= 48 && c <= 57;
}

jugaad convertCodeSyntax(codeText, mode) {
    dekh codeText == nalla || codeText == "" {
        ye_le "";
    }
    dekh mode != "en" && mode != "hi" {
        ye_le codeText;
    }

    pakad toEn = (mode == "en");
    pakad out = "";
    pakad i = 0;
    pakad n = size(codeText);
    pakad prevTok = "";
    pakad prevNonWs = "";
    pakad inForHeader = nhi;
    pakad inClassHeader = nhi;
    pakad forSeCount = 0;

    jabtak i < n {
        pakad ch = codeText.slice(i, i + 1);

        // Preserve double and single quoted string literals verbatim
        dekh ch == "\"" || ch == "'" {
            pakad q = ch;
            out = out + ch;
            i = i + 1;
            jabtak i < n {
                pakad sc = codeText.slice(i, i + 1);
                out = out + sc;
                i = i + 1;
                dekh sc == "\\" && i < n {
                    out = out + codeText.slice(i, i + 1);
                    i = i + 1;
                } warna dekh sc == q {
                    bas;
                }
            }
            prevNonWs = q;
            prevTok = q;
            chal;
        }

        // Preserve line comments // ...
        dekh ch == "/" && i + 1 < n && codeText.slice(i + 1, i + 2) == "/" {
            jabtak i < n && codeText.slice(i, i + 1) != "\n" {
                out = out + codeText.slice(i, i + 1);
                i = i + 1;
            }
            chal;
        }

        // Preserve block comments /* ... */
        dekh ch == "/" && i + 1 < n && codeText.slice(i + 1, i + 2) == "*" {
            out = out + "/*";
            i = i + 2;
            jabtak i < n {
                dekh codeText.slice(i, i + 1) == "*" && i + 1 < n && codeText.slice(i + 1, i + 2) == "/" {
                    out = out + "*/";
                    i = i + 2;
                    bas;
                }
                out = out + codeText.slice(i, i + 1);
                i = i + 1;
            }
            chal;
        }

        // Preserve numeric literals (so floats/hex suffixes are untouched)
        dekh isDigitChar(ch) {
            jabtak i < n && isWordChar(codeText.slice(i, i + 1)) {
                out = out + codeText.slice(i, i + 1);
                i = i + 1;
            }
            prevNonWs = "0";
            prevTok = "0";
            chal;
        }

        // Handle multi-char operators like ->
        dekh ch == "-" && i + 1 < n && codeText.slice(i + 1, i + 2) == ">" {
            out = out + "->";
            i = i + 2;
            prevNonWs = "->";
            prevTok = "->";
            chal;
        }

        // Handle identifiers & keywords
        dekh isWordChar(ch) {
            pakad startIdx = i;
            jabtak i < n && isWordChar(codeText.slice(i, i + 1)) {
                i = i + 1;
            }
            pakad tok = codeText.slice(startIdx, i);
            pakad mapped = tok;

            dekh prevNonWs == "." {
                dekh toEn && HI_TO_EN_METHODS.has(tok) {
                    mapped = HI_TO_EN_METHODS[tok];
                }
            } warna dekh toEn && (prevNonWs == ":" || prevNonWs == "->") {
                dekh TYPE_HI_TO_EN.has(tok) {
                    mapped = TYPE_HI_TO_EN[tok];
                } warna dekh HI_TO_EN_KW.has(tok) {
                    mapped = HI_TO_EN_KW[tok];
                }
            } warna dekh inForHeader && toEn && (tok == "se" || tok == "from") {
                forSeCount = forSeCount + 1;
                dekh forSeCount == 1 {
                    mapped = "from";
                } warna dekh forSeCount == 2 {
                    mapped = "to";
                } warna {
                    mapped = "step";
                }
            } warna dekh inForHeader && !toEn && (tok == "from" || tok == "to" || tok == "step" || tok == "by") {
                mapped = "se";
            } warna dekh tok == "se" && toEn {
                mapped = inClassHeader ? "extends" : "from";
            } warna dekh tok == "bol" && toEn {
                dekh prevNonWs == "" || prevNonWs == ";" || prevNonWs == "{" || prevNonWs == "}" {
                    mapped = "print";
                }
            } warna dekh toEn && HI_TO_EN_KW.has(tok) {
                mapped = HI_TO_EN_KW[tok];
            } warna dekh !toEn && EN_TO_HI_KW.has(tok) {
                mapped = EN_TO_HI_KW[tok];
            }

            dekh tok == "ghoom" || tok == "ghuma" || tok == "for" {
                inForHeader = han;
                forSeCount = 0;
            }
            dekh tok == "biradari" || tok == "sancha" || tok == "roop" || tok == "vibe" || tok == "class" {
                inClassHeader = han;
            }

            out = out + mapped;
            prevTok = tok;
            prevNonWs = tok;
            chal;
        }

        dekh ch == "{" || ch == ";" {
            inForHeader = nhi;
            inClassHeader = nhi;
            forSeCount = 0;
        }

        out = out + ch;
        dekh ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
            prevNonWs = ch;
            prevTok = ch;
        }
        i = i + 1;
    }

    ye_le out;
}

jugaad formatSnippetForMode(baseHindiCode, mode) {
    dekh mode == "en" {
        ye_le convertCodeSyntax(baseHindiCode, "en");
    }
    ye_le baseHindiCode;
}

jugaad stripAnsiCodes(rawText) {
    dekh rawText == nalla || rawText == "" {
        ye_le "";
    }
    pakad esc = akshar_bana(27);
    pakad out = "";
    pakad idx = 0;
    pakad n = size(rawText);
    jabtak idx < n {
        pakad ch = rawText.slice(idx, idx + 1);
        dekh ch == esc && idx + 1 < n && rawText.slice(idx + 1, idx + 2) == "[" {
            idx = idx + 2;
            jabtak idx < n {
                pakad mc = rawText.slice(idx, idx + 1);
                idx = idx + 1;
                dekh mc == "m" || mc == "K" || mc == "J" || mc == "H" {
                    bas;
                }
            }
        } warna {
            out = out + ch;
            idx = idx + 1;
        }
    }
    ye_le out;
}

jugaad classifyCodeLineColor(lineText) {
    pakad trimmed = lineText.trim();
    dekh trimmed == "" {
        ye_le "text-zinc-400";
    }
    dekh trimmed.startsWith("//") || trimmed.startsWith("#") || trimmed.startsWith("/*") || trimmed.startsWith("*") {
        ye_le "text-zinc-500";
    }
    dekh trimmed.startsWith("bula ") || trimmed.startsWith("import ") || trimmed.startsWith("chura ") || trimmed.startsWith("bech ") || trimmed.startsWith("export ") {
        ye_le "text-cyan-400";
    }
    dekh trimmed.startsWith("jugaad ") || trimmed.startsWith("kaam ") || trimmed.startsWith("fn ") || trimmed.startsWith("def ") || trimmed.startsWith("biradari ") || trimmed.startsWith("sancha ") || trimmed.startsWith("class ") || trimmed.startsWith("avtar ") || trimmed.startsWith("enum ") {
        ye_le "text-amber-300";
    }
    dekh trimmed.startsWith("dekh ") || trimmed.startsWith("agar ") || trimmed.startsWith("if ") || trimmed.startsWith("elif ") || trimmed.startsWith("warna") || trimmed.startsWith("else") || trimmed.startsWith("jabtak ") || trimmed.startsWith("while ") || trimmed.startsWith("ghoom ") || trimmed.startsWith("ghuma ") || trimmed.startsWith("for ") || trimmed.startsWith("jaanch ") || trimmed.startsWith("match ") || trimmed.startsWith("panga") || trimmed.startsWith("try") || trimmed.startsWith("lafda") || trimmed.startsWith("catch") || trimmed.startsWith("pakka") || trimmed.startsWith("finally") {
        ye_le "text-fuchsia-300";
    }
    dekh trimmed.startsWith("ye_le ") || trimmed.startsWith("wapas ") || trimmed.startsWith("de ") || trimmed.startsWith("return ") || trimmed.startsWith("chillao ") || trimmed.startsWith("throw ") {
        ye_le "text-emerald-300";
    }
    dekh trimmed.startsWith("dikha") || trimmed.startsWith("print") || trimmed.startsWith("pakad ") || trimmed.startsWith("let ") || trimmed.startsWith("var ") || trimmed.startsWith("const ") || trimmed.startsWith("mut ") || trimmed.startsWith("borrow") || trimmed.startsWith("udhaar") || trimmed.startsWith("ui.") {
        ye_le "text-sky-300";
    }
    ye_le "text-zinc-200";
}

jugaad renderHighlightedCode(codeText) {
    dekh codeText == nalla || codeText == "" {
        ye_le <span className="font-mono text-xs text-zinc-500">{"// empty snippet"}</span>;
    }
    pakad lines = codeText.split("\n");
    pakad lineNodes = [];
    pakad i = 0;
    pakad total = size(lines);
    jabtak i < total {
        pakad ln = lines[i];
        pakad colCls = classifyCodeLineColor(ln);
        pakad dispLn = ln == "" ? " " : ln;
        pakad lnNum = string(i + 1);
        dekh i + 1 < 10 {
            lnNum = " " + lnNum;
        }
        lineNodes.push(
            <div key={i} className="flex flex-row items-start gap-3">
                <span className="font-mono text-xs text-zinc-600 select-none shrink-0">{lnNum}</span>
                <span className={"font-mono text-xs " + colCls}>{dispLn}</span>
            </div>
        );
        i = i + 1;
    }
    ye_le <div className="flex flex-col gap-0.5">{lineNodes}</div>;
}
