bula "ui" jaise { useState };
bula "meme";
bula "./SyntaxHelper.meme" jaise shErr;

jugaad ErrorsView(props) {
    pakad errorsList = props.errorsList;
    pakad syntaxMode = props.syntaxMode != nalla ? props.syntaxMode : "hi";
    pakad onOpenPlayground = props.onOpenPlayground;

    pakad [searchTerm, setSearchTerm] = useState("");
    pakad [activeCat, setActiveCat] = useState("All");
    pakad [testedTitle, setTestedTitle] = useState("");
    pakad [testedOutput, setTestedOutput] = useState("");

    pakad catOpts = ["All", "Arithmetic", "Syntax", "Runtime", "OOP", "Ownership & Borrowing", "Lexer", "Parser", "Type Error"];

    pakad qLower = searchTerm.to_lower();
    pakad filtered = [];
    pakad ei = 0;
    jabtak ei < size(errorsList) {
        pakad item = errorsList[ei];
        pakad matchCat = (activeCat == "All" || item.category == activeCat);
        pakad matchSearch = han;
        dekh qLower != "" {
            pakad tMatch = item.title.to_lower().find(qLower) >= 0;
            pakad qMatch = item.quote.to_lower().find(qLower) >= 0;
            pakad sMatch = item.scenario.to_lower().find(qLower) >= 0;
            pakad oMatch = item.origin.to_lower().find(qLower) >= 0;
            matchSearch = tMatch || qMatch || sMatch || oMatch;
        }
        dekh matchCat && matchSearch {
            filtered.push(item);
        }
        ei = ei + 1;
    }

    jugaad triggerLive(errObj, dispCode) {
        pakad r = meme.eval(dispCode);
        setTestedTitle(errObj.title);
        setTestedOutput(shErr.stripAnsiCodes(r.output));
    }

    pakad catButtons = [];
    pakad ci = 0;
    jabtak ci < size(catOpts) {
        pakad cname = catOpts[ci];
        pakad isAct = (activeCat == cname);
        catButtons.push(
            <button
                key={ci}
                className={isAct ? "px-3 py-1 rounded-full bg-amber-500 text-zinc-950 font-semibold text-xs" : "px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-300 text-xs"}
                onClick={() => setActiveCat(cname)}
            >
                {cname}
            </button>
        );
        ci = ci + 1;
    }

    pakad cards = [];
    pakad fi = 0;
    jabtak fi < size(filtered) {
        pakad errObj = filtered[fi];
        pakad dispCode = shErr.formatSnippetForMode(errObj.code, syntaxMode);
        pakad showLive = (testedTitle == errObj.title && testedOutput != "");
        cards.push(
            <div key={fi} className="rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 flex flex-col gap-3">
                <div className="flex flex-row items-center justify-between gap-2 flex-wrap">
                    <span className="px-2 py-0.5 rounded bg-zinc-800 border border-zinc-700 font-mono text-xs text-amber-300">
                        {errObj.category}
                    </span>
                    <span className="text-xs text-zinc-400">{errObj.origin}</span>
                </div>

                <h2 className="text-base font-bold text-zinc-100">{errObj.title}</h2>
                <span className="font-mono text-xs text-zinc-400">{"Trigger: " + errObj.scenario}</span>

                <div className="p-3 rounded-lg bg-zinc-950 border border-zinc-800 text-xs text-zinc-200">
                    {"\"" + errObj.quote + "\""}
                </div>

                <div className="p-3 rounded-lg bg-zinc-950 border border-zinc-800 overflow-x-auto">
                    {shErr.renderHighlightedCode(dispCode)}
                </div>

                {showLive ? (
                    <div className="p-3 rounded-lg bg-rose-950/30 border border-rose-900 font-mono text-xs text-rose-200">
                        {testedOutput}
                    </div>
                ) : nalla}

                <div className="flex flex-row items-center gap-2">
                    <button
                        className="flex-1 py-2 px-3 rounded-lg bg-zinc-100 text-zinc-950 font-semibold text-xs"
                        onClick={() => triggerLive(errObj, dispCode)}
                    >
                        Trigger Error Live
                    </button>
                    <button
                        className="py-2 px-3 rounded-lg bg-zinc-800 border border-zinc-700 text-zinc-200 text-xs"
                        onClick={() => onOpenPlayground(dispCode)}
                    >
                        Playground
                    </button>
                </div>
            </div>
        );
        fi = fi + 1;
    }

    ye_le (
        <div className="flex flex-col gap-5 max-w-6xl w-full pb-12">
            <div className="flex flex-col gap-2 border-b border-zinc-800 pb-5">
                <div className="flex flex-row items-center gap-2 flex-wrap">
                    <span className="px-2.5 py-1 rounded bg-zinc-900 border border-zinc-700 font-mono text-xs text-amber-400">
                        The Diagnostic Catalog
                    </span>
                    <span className={syntaxMode == "en" ? "px-2 py-1 rounded bg-sky-950 border border-sky-800 font-mono text-xs text-sky-300" : "px-2 py-1 rounded bg-amber-950 border border-amber-800 font-mono text-xs text-amber-300"}>
                        {syntaxMode == "en" ? "English Syntax" : "Fun Hindi Syntax"}
                    </span>
                </div>
                <h1 className="text-2xl font-bold text-zinc-100">{"Iconic Meme Errors (" + string(size(filtered)) + ")"}</h1>
                <p className="text-sm text-zinc-400">
                    MEMElang replaces cryptic compiler failures with iconic Bollywood & internet memes. Trigger any error live in WebAssembly.
                </p>

                <div className="pt-2 flex flex-col gap-3">
                    <input
                        className="w-full max-w-md px-3.5 py-2 rounded-lg bg-zinc-900 border border-zinc-700 text-sm text-zinc-100"
                        placeholder="Search meme errors (e.g. baburao, divide)..."
                        value={searchTerm}
                        onChange={(ev) => setSearchTerm(ev.target.value)}
                    />
                    <div className="flex flex-row items-center gap-2 flex-wrap">
                        {catButtons}
                    </div>
                </div>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                {cards}
            </div>
        </div>
    );
}
