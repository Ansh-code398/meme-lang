bula "ui" jaise { useState };
bula "./CodeBlock.meme" jaise cbMod;
pakad CodeBlockComp = cbMod.CodeBlockView;

jugaad formatDocText(raw) {
    dekh raw == nalla {
        ye_le "";
    }
    ye_le raw;
}

jugaad renderDocBlock(item, idx, onOpenPlayground) {
    pakad bType = item.type;

    dekh bType == "text" {
        ye_le <p key={idx} className="text-sm text-zinc-300">{formatDocText(item.text)}</p>;
    }

    dekh bType == "heading" {
        dekh item.level == 3 {
            ye_le <h3 key={idx} className="text-base font-semibold text-amber-300 mt-3">{item.text}</h3>;
        }
        ye_le (
            <div key={idx} className="pt-4 mt-3 border-t border-zinc-800">
                <h2 className="text-xl font-bold text-zinc-100">{item.text}</h2>
            </div>
        );
    }

    dekh bType == "code" {
        ye_le <div key={idx}><CodeBlockComp title={item.title} code={item.code} onOpenPlayground={onOpenPlayground} /></div>;
    }

    dekh bType == "callout" {
        pakad isWarn = (item.variant == "warning");
        pakad boxCls = isWarn
            ? "p-4 rounded-xl border border-rose-900 bg-rose-950/30 flex flex-col gap-1.5 my-1"
            : "p-4 rounded-xl border border-zinc-800 bg-zinc-900/70 flex flex-col gap-1.5 my-1";
        pakad titleCls = isWarn ? "text-sm font-semibold text-rose-200" : "text-sm font-semibold text-amber-300";
        pakad hasTitle = (item.title != nalla && item.title != "");
        ye_le (
            <div key={idx} className={boxCls}>
                {hasTitle ? <span className={titleCls}>{item.title}</span> : nalla}
                <p className="text-xs text-zinc-300">{formatDocText(item.text)}</p>
            </div>
        );
    }

    dekh bType == "table" {
        pakad hdrs = item.headers;
        pakad rows = item.rows;
        pakad hdrCells = [];
        pakad hi = 0;
        jabtak hi < size(hdrs) {
            hdrCells.push(
                <div key={hi} className="flex-1 font-mono text-xs font-semibold text-zinc-400">
                    {hdrs[hi]}
                </div>
            );
            hi = hi + 1;
        }
        pakad rowNodes = [];
        pakad ri = 0;
        jabtak ri < size(rows) {
            pakad rowData = rows[ri];
            pakad rowCells = [];
            pakad ci = 0;
            jabtak ci < size(rowData) {
                pakad cellText = string(rowData[ci]);
                rowCells.push(
                    <div key={ci} className="flex-1">
                        {ci == 0 ? (
                            <span className="px-2 py-0.5 rounded bg-zinc-800 border border-zinc-700 font-mono text-xs text-amber-300">
                                {cellText}
                            </span>
                        ) : (
                            <span className="text-xs text-zinc-300">{cellText}</span>
                        )}
                    </div>
                );
                ci = ci + 1;
            }
            rowNodes.push(
                <div key={ri} className="w-full flex flex-row items-start gap-4 px-4 py-3 border-t border-zinc-800">
                    {rowCells}
                </div>
            );
            ri = ri + 1;
        }
        ye_le (
            <div key={idx} className="rounded-xl border border-zinc-800 bg-zinc-900/40 overflow-hidden my-1">
                <div className="w-full flex flex-row items-center gap-4 px-4 py-3 bg-zinc-900">
                    {hdrCells}
                </div>
                {rowNodes}
            </div>
        );
    }

    dekh bType == "list" {
        pakad listItems = item.items;
        pakad liNodes = [];
        pakad li = 0;
        jabtak li < size(listItems) {
            liNodes.push(
                <div key={li} className="flex flex-row items-start gap-2.5">
                    <span className="text-amber-400 font-bold text-sm">•</span>
                    <span className="flex-1 text-sm text-zinc-300">{formatDocText(listItems[li])}</span>
                </div>
            );
            li = li + 1;
        }
        ye_le <div key={idx} className="flex flex-col gap-2 pl-2 my-1">{liNodes}</div>;
    }

    dekh bType == "terminal" {
        pakad cmds = item.commands;
        pakad cmdNodes = [];
        pakad ci = 0;
        jabtak ci < size(cmds) {
            cmdNodes.push(
                <div key={ci} className="w-full flex flex-row items-start gap-2">
                    <span className="font-mono text-xs text-zinc-500 shrink-0">{"$"}</span>
                    <span className="flex-1 font-mono text-xs text-emerald-400 font-medium">{cmds[ci]}</span>
                </div>
            );
            ci = ci + 1;
        }
        ye_le (
            <div key={idx} className="rounded-xl border border-zinc-800 bg-zinc-950 p-4 flex flex-col gap-1.5 my-1">
                <span className="font-mono text-xs text-zinc-400 pb-1.5 border-b border-zinc-800">Terminal</span>
                {cmdNodes}
            </div>
        );
    }

    ye_le <div key={idx}></div>;
}

jugaad DocContentView(props) {
    pakad section = props.section;
    pakad prevSection = props.prevSection;
    pakad nextSection = props.nextSection;
    pakad onNavigateSection = props.onNavigateSection;
    pakad onOpenPlayground = props.onOpenPlayground;

    dekh section == nalla {
        ye_le <div className="p-8 text-zinc-400">Section not found.</div>;
    }

    pakad blocks = section.content;
    pakad renderedBlocks = [];
    pakad bi = 0;
    jabtak bi < size(blocks) {
        renderedBlocks.push(renderDocBlock(blocks[bi], bi, onOpenPlayground));
        bi = bi + 1;
    }

    ye_le (
        <div className="flex flex-col gap-4 max-w-4xl w-full pb-12">
            <div className="pb-5 border-b border-zinc-800 flex flex-col gap-2">
                <div className="flex flex-row items-center gap-2">
                    <span className="px-2 py-0.5 rounded bg-zinc-900 border border-zinc-700 font-mono text-xs text-amber-400">
                        {section.id}
                    </span>
                    <span className="text-xs text-zinc-500">MEMElang Reference</span>
                </div>
                <h1 className="text-2xl font-bold text-zinc-100">{section.title}</h1>
                <p className="text-sm text-zinc-400">{section.description}</p>
            </div>

            <div className="flex flex-col gap-3">
                {renderedBlocks}
            </div>

            <div className="mt-6 pt-6 border-t border-zinc-800 flex flex-row items-center justify-between gap-4 flex-wrap">
                {prevSection != nalla ? (
                    <button
                        className="px-4 py-2.5 rounded-xl border border-zinc-800 bg-zinc-900 text-zinc-200 text-xs font-medium text-left"
                        onClick={() => onNavigateSection(prevSection.id)}
                    >
                        {"<- Previous: " + prevSection.title}
                    </button>
                ) : <div></div>}

                {nextSection != nalla ? (
                    <button
                        className="px-4 py-2.5 rounded-xl border border-zinc-700 bg-zinc-800 text-zinc-100 text-xs font-semibold text-right"
                        onClick={() => onNavigateSection(nextSection.id)}
                    >
                        {"Next: " + nextSection.title + " ->"}
                    </button>
                ) : <div></div>}
            </div>
        </div>
    );
}
