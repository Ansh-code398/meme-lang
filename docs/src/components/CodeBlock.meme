bula "ui" jaise { useState };
bula "ui:shadcn" jaise { Badge };
bula "native";
bula "meme";
bula "./SyntaxHelper.meme" jaise shSyntax;

jugaad formatMs(msVal) {
    pakad tenths = bina_point(msVal * 10.0);
    pakad whole = bina_point(tenths / 10);
    pakad frac = tenths - whole * 10;
    dekh frac < 0 { frac = 0; }
    ye_le string(whole) + "." + string(frac);
}

jugaad CodeBlockView(props) {
    pakad title = props.title;
    pakad code = props.code;
    pakad onOpenPlayground = props.onOpenPlayground;

    pakad [copied, setCopied] = useState(nhi);
    pakad [showOut, setShowOut] = useState(nhi);
    pakad [evalOut, setEvalOut] = useState("");
    pakad [evalErr, setEvalErr] = useState(nhi);
    pakad [evalMs, setEvalMs] = useState("0.0");
    pakad [prevCode, setPrevCode] = useState(code);

    dekh code != prevCode {
        setPrevCode(code);
        setCopied(nhi);
        setShowOut(nhi);
        setEvalOut("");
        setEvalErr(nhi);
    }

    pakad safeTitle = (title == nalla || title == "") ? "snippet.meme" : title;

    jugaad handleCopy() {
        native.clipboard.write(code);
        setCopied(han);
    }

    jugaad handleRun() {
        pakad res = meme.eval(code);
        pakad outStr = shSyntax.stripAnsiCodes(res.output);
        dekh outStr == "" {
            dekh res.hasUi {
                outStr = "[MEME-UI rendered " + string(size(res.gpuCommands)) + " GPU draw calls. Open in Playground for live Canvas preview!]";
            } warna {
                outStr = "(Execution completed with no stdout output)";
            }
        }
        setEvalOut(outStr);
        setEvalErr(res.isError);
        setEvalMs(formatMs(res.durationMs));
        setShowOut(han);
    }

    ye_le (
        <div className="flex flex-col rounded-xl border border-zinc-800 bg-zinc-950 overflow-hidden my-2">
            <div className="flex flex-row items-center justify-between gap-2 px-4 py-2.5 bg-zinc-900 border-b border-zinc-800 flex-wrap">
                <div className="flex flex-row items-center gap-2">
                    <span className="font-mono text-xs font-semibold text-amber-400">{"</>"}</span>
                    <span className="font-mono text-xs text-zinc-200 font-medium">{safeTitle}</span>
                </div>
                <div className="flex flex-row items-center gap-2">
                    <button
                        className="px-2.5 py-1 rounded-md bg-zinc-800 border border-zinc-700 text-xs font-medium text-zinc-200"
                        onClick={() => onOpenPlayground(code)}
                    >
                        Playground
                    </button>
                    <button
                        className="px-2.5 py-1 rounded-md bg-zinc-800 border border-zinc-700 text-xs font-medium text-zinc-200"
                        onClick={handleCopy}
                    >
                        {copied ? "Copied!" : "Copy"}
                    </button>
                    <button
                        className="px-3 py-1 rounded-md bg-zinc-100 text-xs font-semibold text-zinc-950"
                        onClick={handleRun}
                    >
                        Run
                    </button>
                </div>
            </div>

            <div className="p-4 overflow-x-auto bg-zinc-950">
                {shSyntax.renderHighlightedCode(code)}
            </div>

            {showOut ? (
                <div className="border-t border-zinc-800 bg-zinc-900 p-4 flex flex-col gap-2">
                    <div className="flex flex-row items-center justify-between gap-2 pb-2 border-b border-zinc-800">
                        <div className="flex flex-row items-center gap-2">
                            <span className="font-mono text-xs font-semibold text-amber-400">WebAssembly Output</span>
                            <span className={evalErr ? "px-2 py-0.5 rounded bg-rose-950 text-rose-300 font-mono text-xs border border-rose-800" : "px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 font-mono text-xs border border-emerald-800"}>
                                {evalErr ? "Error" : "Success"}
                            </span>
                        </div>
                        <div className="flex flex-row items-center gap-3">
                            <span className="font-mono text-xs text-zinc-400">{evalMs + "ms"}</span>
                            <button
                                className="px-2 py-0.5 rounded bg-zinc-800 text-xs text-zinc-300 border border-zinc-700"
                                onClick={() => setShowOut(nhi)}
                            >
                                Close
                            </button>
                        </div>
                    </div>
                    <div className={evalErr ? "p-3 rounded-lg bg-rose-950/30 border border-rose-900 font-mono text-xs text-rose-200" : "p-3 rounded-lg bg-zinc-950 border border-zinc-800 font-mono text-xs text-emerald-300"}>
                        {evalOut}
                    </div>
                </div>
            ) : nalla}
        </div>
    );
}
