                {
                    "type": "code",
                    "title": "test_demo.meme",
                    "code": "assert(10 > 5, \"Ten must be greater than five\");\nassert_eq(2 + 2, 4);\nassert_ne(\"chai\", \"coffee\");\nassert_throws(() => {\n    chillao \"Error condition!\";\n});\ndikha \"All test assertions passed!\";"
                },
                {
                    "type": "heading",
                    "level": 2,
                    "text": "10. json (Serialization & Parsing)"
