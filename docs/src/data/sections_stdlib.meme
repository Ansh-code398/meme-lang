                            "Generates random RFC 4122 v4 UUID string",
                            "crypto.uuid()"
                        ]
                    ]
                },
                {
                    "type": "heading",
                    "level": 2,
                    "text": "5. regex / re / dhundo (Regular Expressions)"
                },
                {
                    "type": "table",
                    "headers": [
                        "Member",
                        "Description",
                        "Example"
                    ],
                    "rows": [
                        [
                            "re.test(pat, str)",
                            "Returns true if pattern matches string anywhere",
                            "re.test(\"^[0-9]+$\", \"123\")"
                        ],
                        [
                            "re.search(pat, str)",
                            "Finds first match with start, end, and groups",
                            "re.search(\"([a-z]+)@\", email)"
                        ],
                        [
                            "re.match(pat, str)",
                            "Matches pattern starting from beginning of string",
                            "re.match(\"[A-Z]+\", \"MEME\")"
                        ],
                        [
                            "re.find_all(pat, str)",
                            "Returns list of all regex match occurrences",
                            "re.find_all(\"[0-9]+\", text)"
                        ],
                        [
