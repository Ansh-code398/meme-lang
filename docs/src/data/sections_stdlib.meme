                    "type": "code",
                    "title": "builtins.meme",
                    "code": "pakad s = \"Namaste Dosto\";\ndikha \"String size:\", size(s);\ndikha \"Type check:\", kya_hai(s);\n\npakad num_str = \"1234\";\npakad num = bina_point(num_str) + 66;\ndikha \"Converted jod:\", num;\n\npakad pi_str = \"3.14159\";\ndikha \"Decimal multiplied:\", point_wala(pi_str) * 2.0;"
                }
