            "content": [
                {
                    "type": "table",
                    "headers": [
                        "Function",
                        "Aliases",
                        "Parameters",
                        "Return Type",
                        "Description"
                    ],
                    "rows": [
                        [
                            "kya_hai(val)",
                            "aukaat",
                            "Any value",
