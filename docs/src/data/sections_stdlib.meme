jugaad getSectionsStdlib() {
    ye_le [
        {
            "id": "modules",
            "title": "Module & File Imports (bula / jaise)",
            "badge": "Architecture",
            "description": "Multi-file modular architecture with `bula` and `jaise`, canonical caching, and circular import detection.",
            "content": [
                {
                    "type": "text",
                    "text": "Organize your project into multiple files using `bula \"<path>\" [jaise <alias>];`. Modules run in isolated namespaces and export top-level variables, functions, and classes."
                },
                {
                    "type": "code",
                    "title": "imports_demo.meme",
                    "code": "// Import with alias\nbula \"./math_utils.meme\" jaise mu;\ndikha mu.add(10, 20);\n\n// Import without alias (auto-derives stem 'helpers')\nbula \"./helpers.meme\";\ndikha helpers.formatText(\"namaste\");\n\n// Circular import protection:\n// If a imports b and b imports a, MEMElang aborts with:\n// \"Golmaal hai sab golmaal hai! Circular import pakda gaya: '<path>'\""
                }
            ]
        },
        {
            "id": "stdlib",
            "title": "Preinstalled Standard Library (\"Batteries-Included\")",
            "badge": "Standard Library",
            "description": "Comprehensive built-in modules preinstalled just like Python: `math`, `random`, `statistics`, `crypto`, `regex`, `datetime`, `itertools`, `collections`, `csv`, `test`, `json`, `file`, and `systumm`.",
            "content": [
                {
                    "type": "text",
                    "text": "MEMElang includes a zero-dependency standard library directly available in global scope or via `bula` / `import`:"
                },
                {
                    "type": "heading",
                    "level": 2,
                    "text": "1. math / hisab (Comprehensive Mathematics)"
                },
                {
                    "type": "table",
                    "headers": [
                        "Member",
                        "WhatsApp Alias",
                        "Description",
                        "Example"
                    ],
                    "rows": [
                        [
                            "math.pi",
                            "hisab.pi",
                            "Mathematical constant pi (3.14159...)",
                            "math.pi"
                        ],
                        [
                            "math.e",
                            "hisab.e",
                            "Euler's constant e (2.71828...)",
                            "math.e"
                        ],
                        [
                            "math.tau",
                            "hisab.tau",
                            "Circle constant tau (6.28318...)",
                            "math.tau"
                        ],
                        [
                            "math.sqrt(x)",
                            "hisab.jadd(x)",
                            "Square root of x",
                            "math.sqrt(49) -> 7.0"
                        ],
                        [
                            "math.cbrt(x)",
                            "-",
                            "Cube root of x",
                            "math.cbrt(27) -> 3.0"
                        ],
                        [
                            "math.pow(b, exp)",
                            "hisab.taqat(b, exp)",
                            "Power base^exp",
                            "math.pow(2, 3) -> 8.0"
                        ],
                        [
                            "math.log(x, base?)",
                            "hisab.ln(x)",
                            "Natural or custom base logarithm",
                            "math.log(100, 10) -> 2.0"
                        ],
                        [
                            "math.sin(x) / cos / tan",
                            "-",
                            "Trigonometric functions",
                            "math.sin(math.pi / 2) -> 1.0"
                        ],
                        [
                            "math.hypot(x, y)",
                            "-",
                            "Euclidean distance sqrt(x^2 + y^2)",
                            "math.hypot(3, 4) -> 5.0"
                        ],
                        [
                            "math.gcd(a, b)",
                            "hisab.mahatam(a, b)",
                            "Greatest Common Divisor",
                            "math.gcd(48, 18) -> 6"
                        ],
                        [
                            "math.lcm(a, b)",
                            "hisab.laghutam(a, b)",
                            "Least Common Multiple",
                            "math.lcm(4, 6) -> 12"
                        ],
                        [
                            "math.factorial(n)",
                            "hisab.kramgunan(n)",
                            "Factorial n!",
                            "math.factorial(6) -> 720"
                        ],
                        [
                            "math.comb(n, k)",
                            "-",
                            "Combinations n choose k",
                            "math.comb(5, 2) -> 10"
                        ],
                        [
                            "math.perm(n, k)",
                            "-",
                            "Permutations nPk",
                            "math.perm(5, 2) -> 20"
                        ],
                        [
                            "math.clamp(val, mn, mx)",
                            "-",
                            "Clamps val into [mn, mx]",
                            "math.clamp(15, 0, 10) -> 10"
                        ]
                    ]
                },
                {
                    "type": "heading",
                    "level": 2,
                    "text": "2. random / tukka (Pseudo-Random Generation)"
                },
                {
                    "type": "table",
                    "headers": [
                        "Member",
                        "Description",
                        "Example"
                    ],
                    "rows": [
                        [
                            "random.seed(n)",
                            "Seeds pseudo-random number generator",
                            "random.seed(42)"
                        ],
                        [
                            "random.random()",
                            "Random float in [0.0, 1.0)",
                            "random.random()"
                        ],
                        [
                            "random.randint(min, max)",
                            "Random integer in [min, max] inclusive",
                            "random.randint(1, 100)"
                        ],
                        [
                            "random.uniform(a, b)",
                            "Random float in [a, b]",
                            "random.uniform(1.5, 5.5)"
                        ],
                        [
                            "random.choice(list)",
                            "Returns random element from sequence",
                            "random.choice([\"chai\", \"samosa\"])"
                        ],
                        [
                            "random.shuffle(list)",
                            "Returns shuffled copy of list in-place",
                            "random.shuffle([1, 2, 3])"
                        ],
                        [
                            "random.sample(list, k)",
                            "Random sample of k unique elements",
                            "random.sample(cards, 5)"
                        ]
                    ]
                },
                {
                    "type": "heading",
                    "level": 2,
                    "text": "3. statistics / stats / aankde (Descriptive Statistics)"
                },
                {
                    "type": "table",
                    "headers": [
                        "Member",
                        "Description",
                        "Example"
                    ],
                    "rows": [
                        [
                            "stats.mean(nums)",
                            "Arithmetic average of sequence",
                            "stats.mean([10, 20, 30]) -> 20.0"
                        ],
                        [
                            "stats.median(nums)",
                            "Middle value in sequence",
                            "stats.median([1, 3, 2]) -> 2.0"
                        ],
                        [
                            "stats.mode(nums)",
                            "Most frequently occurring item",
                            "stats.mode([1, 2, 2, 3]) -> 2"
                        ],
                        [
                            "stats.variance(nums)",
                            "Sample variance of data",
                            "stats.variance([2, 4, 4, 4, 5])"
                        ],
                        [
                            "stats.stdev(nums)",
                            "Standard deviation of data",
                            "stats.stdev([2, 4, 4, 4, 5])"
                        ],
                        [
                            "stats.min(nums) / max(nums)",
                            "Extremum value in sequence",
                            "stats.min([5, 2, 9]) -> 2"
                        ],
                        [
                            "stats.sum(nums)",
                            "Total sum of elements",
                            "stats.sum([1, 2, 3, 4]) -> 10"
                        ]
                    ]
                },
                {
                    "type": "heading",
                    "level": 2,
                    "text": "4. crypto / hashlib / gupt (Cryptography & Hashes)"
                },
                {
                    "type": "table",
                    "headers": [
                        "Member",
                        "Description",
                        "Example"
                    ],
                    "rows": [
                        [
                            "crypto.sha256(data)",
                            "Computes SHA-256 hex digest",
                            "crypto.sha256(\"password\")"
