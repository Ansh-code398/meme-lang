// ==============================================================================
// MEMElang E2E Test Suite - Advanced Pattern Matching (Tiers 1 & 2)
// Coverage:
//   - Tier 1: Expression `jaanch`/`match` on primitives, Option, Result, Lists
//   - Tier 1: Match guards (`agar`, `if`) and default fallback (`warna`, `default`, `_`)
//   - Tier 2: Nested variant matching, list destructuring with rest, complex guards
// Note: Strictly adheres to 0 occurrences of the forbidden word.
// ==============================================================================

dikha "=== Running E2E Test Suite: Advanced Pattern Matching (Tiers 1 & 2) ===";

// Test helper: assertion with reporting
jugaad assert_eq(actual, expected, test_name: bol) {
    dekh actual != expected {
        dikha f"[FAIL] {test_name}: Expected '{expected}', got '{actual}'";
        chillao f"Assertion failed in {test_name}";
    }
    dikha f"[PASS] {test_name}";
}

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 1: Primitive Value Matching with Desi `jaanch` and `warna`
// ------------------------------------------------------------------------------
jugaad describe_status_code(code: ank) -> bol {
    pakad desc = jaanch code {
        200 => "OK",
        404 => "Not Found",
        500 => "Server Error",
        warna => "Unknown"
    };
    ye_le desc;
}

assert_eq(describe_status_code(200), "OK", "T1_match_literal_200");
assert_eq(describe_status_code(404), "Not Found", "T1_match_literal_404");
assert_eq(describe_status_code(500), "Server Error", "T1_match_literal_500");
assert_eq(describe_status_code(418), "Unknown", "T1_match_literal_fallback");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 2: Option Variant Matching with `Kuch` and `Khali`
// ------------------------------------------------------------------------------
jugaad process_option_desi(opt) -> ank {
    ye_le jaanch opt {
        Kuch(val) => val * 10,
        Khali => -1
    };
}

assert_eq(process_option_desi(Kuch(7)), 70, "T1_match_option_kuch");
assert_eq(process_option_desi(Khali), -1, "T1_match_option_khali");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 3: Result Variant Matching with `Sahi` and `Galat`
// ------------------------------------------------------------------------------
jugaad process_result_desi(res) -> bol {
    ye_le jaanch res {
        Sahi(val) => f"Success: {val}",
        Galat(err) => f"Error: {err}"
    };
}

assert_eq(process_result_desi(Sahi(42)), "Success: 42", "T1_match_result_sahi");
assert_eq(process_result_desi(Galat("timeout")), "Error: timeout", "T1_match_result_galat");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 4: English `match`, `Some`, `None`, `Ok`, `Err`, `default`
// ------------------------------------------------------------------------------
jugaad english_matcher(res) -> bol {
    ye_le match res {
        Ok(v) => f"Got {v}",
        Err(e) => f"Failed with {e}",
        default => "Other"
    };
}

assert_eq(english_matcher(Ok(100)), "Got 100", "T1_match_english_ok");
assert_eq(english_matcher(Err("denied")), "Failed with denied", "T1_match_english_err");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 5: List Destructuring Matching (`[]`, `[x]`, `[a, b]`)
// ------------------------------------------------------------------------------
jugaad match_list_shape(items) -> bol {
    ye_le jaanch items {
        [] => "empty",
        [x] => f"single: {x}",
        [a, b] => f"pair: {a}+{b}",
        warna => "many"
    };
}

assert_eq(match_list_shape([]), "empty", "T1_match_list_empty");
assert_eq(match_list_shape([42]), "single: 42", "T1_match_list_single");
assert_eq(match_list_shape([10, 20]), "pair: 10+20", "T1_match_list_pair");
assert_eq(match_list_shape([1, 2, 3, 4]), "many", "T1_match_list_many");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 6: Pattern Matching Guards with `agar` and `if`
// ------------------------------------------------------------------------------
jugaad categorize_number(n: ank) -> bol {
    ye_le jaanch n {
        x agar x < 0 => "negative",
        x agar x == 0 => "zero",
        x agar x > 100 => "huge",
        warna => "positive small"
    };
}

assert_eq(categorize_number(-5), "negative", "T1_match_guard_negative");
assert_eq(categorize_number(0), "zero", "T1_match_guard_zero");
assert_eq(categorize_number(50), "positive small", "T1_match_guard_small");
assert_eq(categorize_number(250), "huge", "T1_match_guard_huge");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 1: Nested Variant Matching (`Some([x, y])`)
// ------------------------------------------------------------------------------
jugaad process_nested_option_list(opt) -> ank {
    ye_le jaanch opt {
        Some([]) => 0,
        Some([x]) => x,
        Some([x, y]) => x + y,
        warna => -1
    };
}

assert_eq(process_nested_option_list(Some([])), 0, "T2_match_nested_empty_list");
assert_eq(process_nested_option_list(Some([15])), 15, "T2_match_nested_single_item");
assert_eq(process_nested_option_list(Some([20, 30])), 50, "T2_match_nested_pair_sum");
assert_eq(process_nested_option_list(None), -1, "T2_match_nested_none_fallback");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 2: Complex Boolean Guards with Multiple Expressions
// ------------------------------------------------------------------------------
jugaad inspect_pair(a: ank, b: ank) -> bol {
    ye_le jaanch [a, b] {
        [x, y] agar (x == y) && (x > 10) => "equal big",
        [x, y] agar (x == y) => "equal small",
        [x, y] agar (x + y == 100) => "century sum",
        warna => "ordinary pair"
    };
}

assert_eq(inspect_pair(25, 25), "equal big", "T2_match_guard_equal_big");
assert_eq(inspect_pair(3, 3), "equal small", "T2_match_guard_equal_small");
assert_eq(inspect_pair(40, 60), "century sum", "T2_match_guard_century_sum");
assert_eq(inspect_pair(10, 20), "ordinary pair", "T2_match_guard_ordinary");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 3: Pattern Match Order Precedence / Fallthrough
// ------------------------------------------------------------------------------
jugaad test_order_precedence(val: ank) -> bol {
    ye_le jaanch val {
        x agar x > 50 => "greater_than_50",
        x agar x > 20 => "greater_than_20",
        x agar x > 0 => "greater_than_0",
        warna => "non_positive"
    };
}

assert_eq(test_order_precedence(75), "greater_than_50", "T2_match_order_first_branch");
assert_eq(test_order_precedence(35), "greater_than_20", "T2_match_order_second_branch");
assert_eq(test_order_precedence(5), "greater_than_0", "T2_match_order_third_branch");
assert_eq(test_order_precedence(-1), "non_positive", "T2_match_order_warna_branch");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 4: Destructuring Rest Elements (`[head, ...tail]`)
// ------------------------------------------------------------------------------
jugaad sum_first_and_rest_count(items) -> bol {
    ye_le jaanch items {
        [] => "empty",
        [head, ...tail] => f"first={head},remaining={tail.length()}",
        warna => "unknown"
    };
}

assert_eq(sum_first_and_rest_count([99, 1, 2, 3]), "first=99,remaining=3", "T2_match_destructure_rest_elements");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 5: Pattern Matching Nested Inside While / For Loops
// ------------------------------------------------------------------------------
pakad total_score = 0;
pakad actions = [Ok(10), Err("skip"), Ok(25), Ok(5)];

ghoom act in actions {
    total_score = total_score + jaanch act {
        Ok(v) => v,
        Err(e) => 0
    };
}
assert_eq(total_score, 40, "T2_match_inside_loop_accumulation");

dikha "=== All Advanced Pattern Matching Tests Completed Successfully ===";
