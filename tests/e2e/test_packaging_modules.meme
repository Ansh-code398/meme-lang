// ==============================================================================
// MEMElang E2E Test Suite - Module Packaging & Exports (Tiers 1 & 2)
// Coverage:
//   - Tier 1: Package declarations (`potli`, `package`, `dibbi`, `bundle`, `pkg`)
//   - Tier 1: Exports (`bech`, `export`, `khula`, `baahar`, `pub`)
//   - Tier 1: Exporting functions, classes, and variables
//   - Tier 2: Unexported private helper isolation, multiple exports, typed signatures
// Note: Strictly adheres to 0 occurrences of the forbidden word.
// ==============================================================================

dikha "=== Running E2E Test Suite: Module Packaging & Exports (Tiers 1 & 2) ===";

// Test helper: assertion with reporting
jugaad assert_eq(actual, expected, test_name: bol) {
    dekh actual != expected {
        dikha f"[FAIL] {test_name}: Expected '{expected}', got '{actual}'";
        chillao f"Assertion failed in {test_name}";
    }
    dikha f"[PASS] {test_name}";
}

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 1: Package Declaration with Desi `potli` and English `package`
// ------------------------------------------------------------------------------
potli MeraMathPackage;

jugaad get_pkg_name() -> bol {
    ye_le "MeraMathPackage";
}

assert_eq(get_pkg_name(), "MeraMathPackage", "T1_pkg_potli_declaration");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 2: Function Export with `bech` and `export`
// ------------------------------------------------------------------------------
bech jugaad square_num(n: ank) -> ank {
    ye_le n * n;
}

export fn cube_num(n: ank) -> ank {
    ye_le n * n * n;
}

assert_eq(square_num(6), 36, "T1_pkg_export_fn_desi");
assert_eq(cube_num(4), 64, "T1_pkg_export_fn_english");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 3: Class Export with `bech sancha` and `export class`
// ------------------------------------------------------------------------------
bech sancha CalculatorTool {
    kaam shuru(base_val: ank) {
        khud.base = base_val;
    }

    kaam multiply(factor: ank) -> ank {
        ye_le khud.base * factor;
    }
}

export class GreeterTool {
    kaam shuru(name: bol) {
        khud.name = name;
    }

    kaam greet() -> bol {
        ye_le f"Ram Ram, {khud.name}!";
    }
}

pakad calc = new CalculatorTool(10);
assert_eq(calc.multiply(5), 50, "T1_pkg_export_class_desi");

pakad greeter = new GreeterTool("MEMElang");
assert_eq(greeter.greet(), "Ram Ram, MEMElang!", "T1_pkg_export_class_english");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 4: Variable & Constant Export with `bech pakad` / `export let`
// ------------------------------------------------------------------------------
bech pakad MAX_BUFFER_SIZE = 4096;
export let DEFAULT_ENCODING = "UTF-8";

assert_eq(MAX_BUFFER_SIZE, 4096, "T1_pkg_export_var_desi");
assert_eq(DEFAULT_ENCODING, "UTF-8", "T1_pkg_export_var_english");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 5: Packaging & Export Aliases (`dibbi`, `bundle`, `pkg`, `khula`, `baahar`, `pub`)
// ------------------------------------------------------------------------------
khula jugaad add_nums(a: ank, b: ank) -> ank {
    ye_le a + b;
}

baahar jugaad sub_nums(a: ank, b: ank) -> ank {
    ye_le a - b;
}

pub fn mul_nums(a: ank, b: ank) -> ank {
    ye_le a * b;
}

assert_eq(add_nums(15, 25), 40, "T1_pkg_alias_khula");
assert_eq(sub_nums(50, 18), 32, "T1_pkg_alias_baahar");
assert_eq(mul_nums(7, 8), 56, "T1_pkg_alias_pub");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 1: Unexported Internal Helper Functions
// ------------------------------------------------------------------------------
// Internal helper function not exported:
jugaad _internal_sanitize_token(raw: bol) -> bol {
    ye_le f"clean_{raw}";
}

bech jugaad process_token(raw: bol) -> bol {
    ye_le _internal_sanitize_token(raw);
}

assert_eq(process_token("secret"), "clean_secret", "T2_pkg_internal_helper_resolution");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 2: Multiple Consecutive Exports & Higher-Order Functions
// ------------------------------------------------------------------------------
bech jugaad apply_transform(val: ank, transform_fn) -> ank {
    ye_le transform_fn(val);
}

bech pakad double_fn = jugaad(x) { ye_le x * 2; };
assert_eq(apply_transform(21, double_fn), 42, "T2_pkg_export_higher_order_fn");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 3: Exported Class with Static & Instance Members
// ------------------------------------------------------------------------------
bech sancha VersionInfo {
    kaam shuru(major: ank, minor: ank, patch: ank) {
        khud.major = major;
        khud.minor = minor;
        khud.patch = patch;
    }

    kaam to_string() -> bol {
        ye_le f"{khud.major}.{khud.minor}.{khud.patch}";
    }
}

pakad ver = new VersionInfo(2, 5, 1);
assert_eq(ver.to_string(), "2.5.1", "T2_pkg_export_class_state_methods");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 4: Export with Default Parameters & Type Signatures
// ------------------------------------------------------------------------------
bech jugaad compute_tax(amount: ank, rate: ank = 18) -> ank {
    ye_le (amount * rate) / 100;
}

assert_eq(compute_tax(1000), 180, "T2_pkg_export_default_param");
assert_eq(compute_tax(1000, 12), 120, "T2_pkg_export_custom_param");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 5: Chained Package Method Calls
// ------------------------------------------------------------------------------
bech sancha FluentBuilder {
    kaam shuru() {
        khud.text = "";
    }

    kaam append(part: bol) {
        khud.text = khud.text + part;
        ye_le khud;
    }

    kaam build() -> bol {
        ye_le khud.text;
    }
}

pakad builder = new FluentBuilder();
pakad final_str = builder.append("GOAT").append(" ").append("Lang").build();
assert_eq(final_str, "GOAT Lang", "T2_pkg_fluent_builder_export");

dikha "=== All Packaging & Export E2E Tests Completed Successfully ===";
