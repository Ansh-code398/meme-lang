// ==============================================================================
// MEMElang E2E Test Suite - Real-World Application Scenarios (Tier 4)
// Coverage:
//   - Realistic complete programs combining multiple language features:
//     1. AnokhaPtr (Rust/C++-style Unique Pointer container)
//     2. PhysicsVector2D (Mathematical vector engine with operator overloading)
//     3. Singly LinkedList (Pointer-based linked node chain)
//     4. Scoped Connection Pool (RAII resource manager with daayra lifecycle)
//     5. Polymorphic Event Bus (Event routing via function overloading)
// Note: Strictly adheres to 0 occurrences of the forbidden word.
// ==============================================================================

dikha "=== Running E2E Test Suite: Real-World Scenarios (Tier 4) ===";

// Test helper: assertion with reporting
jugaad assert_eq(actual, expected, test_name: bol) {
    dekh actual != expected {
        dikha f"[FAIL] {test_name}: Expected '{expected}', got '{actual}'";
        chillao f"Assertion failed in {test_name}";
    }
    dikha f"[PASS] {test_name}";
}

// ==============================================================================
// SCENARIO 1: AnokhaPtr (Unique Pointer Container)
// Demonstrates: Exclusive ownership, move semantics, pointer deref, and RAII drop.
// ==============================================================================
pakad cleanup_registry = [];

biradari AnokhaPtr {
    jugaad shuru(resource_id: bol, initial_val: ank) {
        khud.id = resource_id;
        khud.val = initial_val;
        khud.alive = han;
    }

    tantrik - () {
        ye_le khud.val;
    }

    jugaad get_val() -> ank {
        ye_le khud.val;
    }

    jugaad set_val(new_val: ank) {
        khud.val = new_val;
    }

    jugaad alvida() {
        dekh khud.alive {
            cleanup_registry.jod(khud.id);
            khud.alive = nhi;
        }
    }
}

jugaad transfer_ownership_sink(ptr_dest) {
    ptr_dest.set_val(ptr_dest.get_val() + 100);
    // ptr_dest drops when function finishes
}

daayra {
    pakad malik uptr1 = AnokhaPtr("Buffer_A", 50);
    assert_eq(uptr1.get_val(), 50, "T4_scenario1_unique_ptr_init");

    pakad uptr2 = rawana uptr1;
    assert_eq(uptr2.get_val(), 50, "T4_scenario1_unique_ptr_moved");

    transfer_ownership_sink(rawana uptr2);
}
assert_eq(cleanup_registry.size() > 0, han, "T4_scenario1_unique_ptr_raii_dropped");
assert_eq(cleanup_registry[0], "Buffer_A", "T4_scenario1_unique_ptr_correct_drop_id");

// ==============================================================================
// SCENARIO 2: PhysicsVector2D Engine
// Demonstrates: Operator overloading (+, -, *), __dikha__, and overloaded methods.
// ==============================================================================
biradari PhysicsVector2D {
    jugaad shuru(x: ank, y: ank) {
        khud.x = x;
        khud.y = y;
    }

    tantrik + (other: PhysicsVector2D) -> PhysicsVector2D {
        ye_le PhysicsVector2D(khud.x + other.x, khud.y + other.y);
    }

    tantrik - (other: PhysicsVector2D) -> PhysicsVector2D {
        ye_le PhysicsVector2D(khud.x - other.x, khud.y - other.y);
    }

    tantrik * (scalar: ank) -> PhysicsVector2D {
        ye_le PhysicsVector2D(khud.x * scalar, khud.y * scalar);
    }

    tantrik == (other: PhysicsVector2D) -> sach {
        ye_le khud.x == other.x aur khud.y == other.y;
    }

    jugaad dot(other: PhysicsVector2D) -> ank {
        ye_le (khud.x * other.x) + (khud.y * other.y);
    }

    jugaad __dikha__() -> bol {
        ye_le f"Vec({khud.x},{khud.y})";
    }
}

bahuroop jugaad compute_force(mass: ank, accel: PhysicsVector2D) -> PhysicsVector2D {
    ye_le accel * mass;
}

bahuroop jugaad compute_force(v1: PhysicsVector2D, v2: PhysicsVector2D) -> ank {
    ye_le v1.dot(v2);
}

pakad v_pos = PhysicsVector2D(5, 10);
pakad v_vel = PhysicsVector2D(2, 3);
pakad v_next = v_pos + v_vel;
assert_eq(v_next.x, 7, "T4_scenario2_physics_vec_add_x");
assert_eq(v_next.y, 13, "T4_scenario2_physics_vec_add_y");

pakad f1 = compute_force(10, v_vel);
assert_eq(f1.x, 20, "T4_scenario2_physics_overloaded_force_vec_x");
assert_eq(f1.y, 30, "T4_scenario2_physics_overloaded_force_vec_y");

pakad work = compute_force(v_pos, v_vel);
assert_eq(work, 40, "T4_scenario2_physics_overloaded_force_dot");

// ==============================================================================
// SCENARIO 3: Pointer-Linked Chain (Singly Linked List Node)
// Demonstrates: Raw pointers, address-of (&), deref (*), mutating memory slots.
// ==============================================================================
biradari SthalNode {
    jugaad shuru(val: ank) {
        khud.val = val;
        khud.has_next = nhi;
        khud.next_val = 0;
    }

    jugaad set_link(next_val: ank) {
        khud.has_next = han;
        khud.next_val = next_val;
    }
}

pakad node1 = SthalNode(10);
pakad node2 = SthalNode(20);
pakad node3 = SthalNode(30);

node1.set_link(node2.val);
node2.set_link(node3.val);

pakad p_n1 = &node1.val;
pakad p_n2 = &node2.val;
pakad p_n3 = &node3.val;

// Update values in chain through pointers
*p_n1 = *p_n1 + 5;
*p_n2 = *p_n2 + 5;
*p_n3 = *p_n3 + 5;

assert_eq(node1.val, 15, "T4_scenario3_linked_chain_ptr_update_node1");
assert_eq(node2.val, 25, "T4_scenario3_linked_chain_ptr_update_node2");
assert_eq(node3.val, 35, "T4_scenario3_linked_chain_ptr_update_node3");

// ==============================================================================
// SCENARIO 4: Scoped Database Connection Pool
// Demonstrates: Lexical blocks (daayra), borrowing (udhaar), and RAII drops.
// ==============================================================================
pakad connection_status = "IDLE";

biradari DbSession {
    jugaad shuru(db_name: bol) {
        khud.db_name = db_name;
        connection_status = "CONNECTED";
    }

    jugaad query(q: bol) -> bol {
        ye_le f"SUCCESS:{khud.db_name}:{q}";
    }

    jugaad alvida() {
        connection_status = "RELEASED";
    }
}

daayra {
    pakad session = DbSession("MainWarehouse");
    assert_eq(connection_status, "CONNECTED", "T4_scenario4_db_pool_connected");

    pakad res_query = session.query("SELECT * FROM items");
    assert_eq(res_query, "SUCCESS:MainWarehouse:SELECT * FROM items", "T4_scenario4_db_pool_query");
}
assert_eq(connection_status, "RELEASED", "T4_scenario4_db_pool_released_on_scope_exit");

// ==============================================================================
// SCENARIO 5: Polymorphic Message & Event Dispatcher
// Demonstrates: Function overloading with distinct event payload types.
// ==============================================================================
biradari ClickEvent {
    jugaad shuru(x: ank, y: ank) { khud.x = x; khud.y = y; }
}

biradari KeyEvent {
    jugaad shuru(code: ank) { khud.code = code; }
}

biradari SystemEvent {
    jugaad shuru(msg: bol) { khud.msg = msg; }
}

bahuroop jugaad dispatch_event(evt: ClickEvent) -> bol {
    ye_le f"CLICK({evt.x},{evt.y})";
}

bahuroop jugaad dispatch_event(evt: KeyEvent) -> bol {
    ye_le f"KEY({evt.code})";
}

aur_ek jugaad dispatch_event(evt: SystemEvent) -> bol {
    ye_le f"SYSTEM({evt.msg})";
}

pakad ev1 = ClickEvent(1920, 1080);
pakad ev2 = KeyEvent(13);
pakad ev3 = SystemEvent("SHUTDOWN_REQUEST");

assert_eq(dispatch_event(ev1), "CLICK(1920,1080)", "T4_scenario5_event_click_dispatch");
assert_eq(dispatch_event(ev2), "KEY(13)", "T4_scenario5_event_key_dispatch");
assert_eq(dispatch_event(ev3), "SYSTEM(SHUTDOWN_REQUEST)", "T4_scenario5_event_system_dispatch");

dikha "=== All Real-World Application Scenarios (Tier 4) Completed Successfully! ===";
