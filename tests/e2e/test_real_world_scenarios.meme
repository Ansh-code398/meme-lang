// ==============================================================================
// MEMElang E2E Test Suite - Tier 4: Real-World Application Scenarios
// Real-world, non-trivial application architectures combining:
//   - Scenario 1: `PackageManagerRegistry` (Package/Module management, semver, Result/Option)
//   - Scenario 2: `JsonParserAstEngine` (Tokenizer, AST variants, recursive parsing, `?`)
//   - Scenario 3: `ConfigurationPipeline` (Namespaces, schema validation, Result/unwrap_or)
//   - Scenario 4: `TaskWorkflowDispatcher` (State machine, transition matching with guards)
//   - Scenario 5: `ExpressionAstEvaluator` (Recursive AST evaluation, Div-by-zero, `?`)
// Note: Strictly adheres to 0 occurrences of the forbidden word.
// ==============================================================================

dikha "=== Running E2E Test Suite: Tier 4 Real-World Application Scenarios ===";

// Test helper: assertion with reporting
jugaad assert_eq(actual, expected, test_name: bol) {
    dekh actual != expected {
        dikha f"[FAIL] {test_name}: Expected '{expected}', got '{actual}'";
        chillao f"Assertion failed in {test_name}";
    }
    dikha f"[PASS] {test_name}";
}

// ------------------------------------------------------------------------------
// SCENARIO 1: Package Manager & Dependency Registry (`PackageManagerRegistry`)
// ------------------------------------------------------------------------------
mohalla Registry {
    sancha PackageRecord {
        kaam shuru(name: bol, major: ank, minor: ank, patch: ank) {
            khud.name = name;
            khud.major = major;
            khud.minor = minor;
            khud.patch = patch;
        }

        kaam version_string() -> bol {
            ye_le f"{khud.major}.{khud.minor}.{khud.patch}";
        }
    }

    pakad _catalog = {};

    jugaad register_package(name: bol, major: ank, minor: ank, patch: ank) {
        dekh major < 0 || minor < 0 || patch < 0 {
            ye_le Err("Negative version numbers invalid");
        }
        pakad rec = new Registry::PackageRecord(name, major, minor, patch);
        _catalog[name] = rec;
        ye_le Ok(rec);
    }

    jugaad find_package(name: bol) {
        dekh _catalog.has(name) {
            ye_le Some(_catalog[name]);
        }
        ye_le None;
    }
}

jugaad install_dependency(name: bol, min_major: ank) {
    pakad pkg_opt = Registry::find_package(name);
    pakad rec = jaanch pkg_opt {
        Some(p) => p,
        None => { ye_le Err(f"Package '{name}' not found"); }
    };

    dekh rec.major < min_major {
        ye_le Err(f"Package '{name}' version {rec.version_string()} does not meet min major {min_major}");
    }
    ye_le Ok(f"Installed {rec.name}@{rec.version_string()}");
}

Registry::register_package("serde_meme", 2, 1, 0);
Registry::register_package("tokio_desi", 1, 0, 4);

assert_eq(install_dependency("serde_meme", 2).unwrap(), "Installed serde_meme@2.1.0", "T4_scenario_package_mgr_install_ok");
assert_eq(install_dependency("serde_meme", 3).unwrap_err(), "Package 'serde_meme' version 2.1.0 does not meet min major 3", "T4_scenario_package_mgr_version_mismatch");
assert_eq(install_dependency("missing_lib", 1).unwrap_err(), "Package 'missing_lib' not found", "T4_scenario_package_mgr_missing");

// ------------------------------------------------------------------------------
// SCENARIO 2: Recursive Descent JSON AST Parser (`JsonParserAstEngine`)
// ------------------------------------------------------------------------------
mohalla JsonEngine {
    sancha Token {
        kaam shuru(kind: bol, text: bol, num: ank) {
            khud.kind = kind;
            khud.text = text;
            khud.num = num;
        }
    }

    jugaad tokenize_primitive(s: bol) {
        dekh s == "null" {
            ye_le Ok(new JsonEngine::Token("NULL", "", 0));
        }
        dekh s == "true" {
            ye_le Ok(new JsonEngine::Token("BOOL", "true", 1));
        }
        dekh s == "false" {
            ye_le Ok(new JsonEngine::Token("BOOL", "false", 0));
        }
        ye_le Ok(new JsonEngine::Token("STRING", s, 0));
    }

    jugaad parse_single_token(tok) {
        ye_le jaanch tok.kind {
            "NULL" => Ok("ParsedNull"),
            "BOOL" agar tok.num == 1 => Ok("ParsedTrue"),
            "BOOL" => Ok("ParsedFalse"),
            "STRING" => Ok(f"ParsedString:{tok.text}"),
            warna => Err("Unknown token type")
        };
    }
}

jugaad parse_json_primitive(raw: bol) {
    pakad tok = JsonEngine::tokenize_primitive(raw)?;
    pakad parsed = JsonEngine::parse_single_token(tok)?;
    ye_le Ok(parsed);
}

assert_eq(parse_json_primitive("null").unwrap(), "ParsedNull", "T4_scenario_json_null");
assert_eq(parse_json_primitive("true").unwrap(), "ParsedTrue", "T4_scenario_json_true");
assert_eq(parse_json_primitive("false").unwrap(), "ParsedFalse", "T4_scenario_json_false");
assert_eq(parse_json_primitive("hello").unwrap(), "ParsedString:hello", "T4_scenario_json_string");

// ------------------------------------------------------------------------------
// SCENARIO 3: Application Configuration Loader Pipeline (`ConfigurationPipeline`)
// ------------------------------------------------------------------------------
mohalla ConfigPipeline {
    jugaad validate_port(port: ank) {
        dekh port < 1 || port > 65535 {
            ye_le Err(f"Port {port} out of valid range (1-65535)");
        }
        ye_le Ok(port);
    }

    jugaad get_env_profile(env_name: bol) {
        ye_le jaanch env_name {
            "prod" => Ok("PRODUCTION"),
            "staging" => Ok("STAGING"),
            "dev" => Ok("DEVELOPMENT"),
            warna => Err(f"Invalid environment: '{env_name}'")
        };
    }

    jugaad build_server_config(env_str: bol, port: ank, custom_workers) {
        pakad env_profile = ConfigPipeline::get_env_profile(env_str)?;
        pakad valid_port = ConfigPipeline::validate_port(port)?;
        pakad workers = custom_workers.unwrap_or(4);
        ye_le Ok(f"{env_profile}:{valid_port}:{workers}");
    }
}

assert_eq(ConfigPipeline::build_server_config("prod", 8080, Some(16)).unwrap(), "PRODUCTION:8080:16", "T4_scenario_config_prod_custom_workers");
assert_eq(ConfigPipeline::build_server_config("dev", 3000, None).unwrap(), "DEVELOPMENT:3000:4", "T4_scenario_config_dev_default_workers");
assert_eq(ConfigPipeline::build_server_config("invalid_env", 8080, None).unwrap_err(), "Invalid environment: 'invalid_env'", "T4_scenario_config_bad_env");
assert_eq(ConfigPipeline::build_server_config("staging", 99999, None).unwrap_err(), "Port 99999 out of valid range (1-65535)", "T4_scenario_config_bad_port");

// ------------------------------------------------------------------------------
// SCENARIO 4: State Machine Task Workflow Dispatcher (`TaskWorkflowDispatcher`)
// ------------------------------------------------------------------------------
mohalla WorkflowDispatcher {
    sancha TaskState {
        kaam shuru(id: ank, status: bol, retries: ank) {
            khud.id = id;
            khud.status = status;
            khud.retries = retries;
        }
    }

    jugaad advance_task(task, event: bol) {
        ye_le jaanch [task.status, event] {
            ["PENDING", "START"] => {
                task.status = "RUNNING";
                Ok("Task started")
            },
            ["RUNNING", "COMPLETE"] => {
                task.status = "COMPLETED";
                Ok("Task completed successfully")
            },
            ["RUNNING", "FAIL"] agar task.retries < 3 => {
                task.retries = task.retries + 1;
                task.status = "PENDING";
                Ok(f"Task retry #{task.retries} queued")
            },
            ["RUNNING", "FAIL"] => {
                task.status = "FAILED";
                Err("Task failed permanently, max retries exceeded")
            },
            warna => Err(f"Invalid transition from state '{task.status}' on event '{event}'")
        };
    }
}

pakad my_task = new WorkflowDispatcher::TaskState(101, "PENDING", 0);
assert_eq(WorkflowDispatcher::advance_task(my_task, "START").unwrap(), "Task started", "T4_scenario_workflow_start");
assert_eq(WorkflowDispatcher::advance_task(my_task, "FAIL").unwrap(), "Task retry #1 queued", "T4_scenario_workflow_retry1");
assert_eq(WorkflowDispatcher::advance_task(my_task, "START").unwrap(), "Task started", "T4_scenario_workflow_restart");
assert_eq(WorkflowDispatcher::advance_task(my_task, "COMPLETE").unwrap(), "Task completed successfully", "T4_scenario_workflow_complete");
assert_eq(my_task.status, "COMPLETED", "T4_scenario_workflow_final_status");

// ------------------------------------------------------------------------------
// SCENARIO 5: Recursive Arithmetic AST Evaluator (`ExpressionAstEvaluator`)
// ------------------------------------------------------------------------------
mohalla AstEvaluator {
    sancha Node {
        kaam shuru(oper: bol, val: ank, left, right) {
            khud.oper = oper;
            khud.val = val;
            khud.left = left;
            khud.right = right;
        }
    }

    jugaad num(v: ank) {
        ye_le new AstEvaluator::Node("NUM", v, None, None);
    }

    jugaad bin_op(oper: bol, left, right) {
        ye_le new AstEvaluator::Node(oper, 0, Some(left), Some(right));
    }

    jugaad eval(node) {
        dekh node.oper == "NUM" {
            ye_le Ok(node.val);
        }

        pakad l_val = AstEvaluator::eval(node.left.unwrap())?;
        pakad r_val = AstEvaluator::eval(node.right.unwrap())?;

        ye_le jaanch node.oper {
            "+" => Ok(l_val + r_val),
            "-" => Ok(l_val - r_val),
            "*" => Ok(l_val * r_val),
            "/" agar r_val == 0 => Err("Math error: Division by zero"),
            "/" => Ok(l_val / r_val),
            warna => Err(f"Unsupported operator: {node.oper}")
        };
    }
}

// Tree: ( (10 + 20) * 3 ) - (50 / 2) = (30 * 3) - 25 = 90 - 25 = 65
pakad tree = AstEvaluator::bin_op("-",
    AstEvaluator::bin_op("*",
        AstEvaluator::bin_op("+", AstEvaluator::num(10), AstEvaluator::num(20)),
        AstEvaluator::num(3)
    ),
    AstEvaluator::bin_op("/", AstEvaluator::num(50), AstEvaluator::num(2))
);

assert_eq(AstEvaluator::eval(tree).unwrap(), 65, "T4_scenario_ast_eval_complex_expression");

// Tree with division by zero: 100 / (5 - 5)
pakad div_zero_tree = AstEvaluator::bin_op("/",
    AstEvaluator::num(100),
    AstEvaluator::bin_op("-", AstEvaluator::num(5), AstEvaluator::num(5))
);
assert_eq(AstEvaluator::eval(div_zero_tree).unwrap_err(), "Math error: Division by zero", "T4_scenario_ast_eval_div_by_zero");

dikha "=== All Tier 4 Real-World Application Scenarios Completed Successfully ===";
