// ==============================================================================
// MEMElang E2E Test Suite - Function & Operator Overloading (Tiers 1 & 2)
// Coverage:
//   - Tier 1: Function overloading (arity & types, Desi & English syntax)
//   - Tier 1: Operator overloading (binary, comparison, indexing, unary)
//   - Tier 2: Overload resolution scoring, auto-derived operators, boundary errors
// Note: Strictly adheres to 0 occurrences of the forbidden word.
// ==============================================================================

dikha "=== Running E2E Test Suite: Overloading (Tiers 1 & 2) ===";

// Test helper: assertion with reporting
jugaad assert_eq(actual, expected, test_name: bol) {
    dekh actual != expected {
        dikha f"[FAIL] {test_name}: Expected '{expected}', got '{actual}'";
        chillao f"Assertion failed in {test_name}";
    }
    dikha f"[PASS] {test_name}";
}

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 1: Function Overloading by Arity
// ------------------------------------------------------------------------------
bahuroop jugaad hisaab(a: ank) -> ank {
    ye_le a * 10;
}

bahuroop jugaad hisaab(a: ank, b: ank) -> ank {
    ye_le a + b;
}

aur_ek jugaad hisaab(a: ank, b: ank, c: ank) -> ank {
    ye_le (a + b) * c;
}

assert_eq(hisaab(5), 50, "T1_fn_overload_arity_1");
assert_eq(hisaab(12, 18), 30, "T1_fn_overload_arity_2");
assert_eq(hisaab(3, 4, 5), 35, "T1_fn_overload_arity_3");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 1: Function Overloading by Parameter Types
// ------------------------------------------------------------------------------
bahuroop jugaad jodo(a: ank, b: ank) -> ank {
    ye_le a + b;
}

bahuroop jugaad jodo(s1: bol, s2: bol) -> bol {
    ye_le s1 + " " + s2;
}

aur_ek jugaad jodo(flag: sach, val: ank) -> bol {
    ye_le flag ? f"Haan:{val}" : f"Na:{val}";
}

assert_eq(jodo(25, 75), 100, "T1_fn_overload_type_int");
assert_eq(jodo("MEME", "Lang"), "MEME Lang", "T1_fn_overload_type_string");
assert_eq(jodo(han, 42), "Haan:42", "T1_fn_overload_type_bool_int");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 1: English Overload Syntax (`overload` & `multimethod`)
// ------------------------------------------------------------------------------
overload fn format_item(x: int) -> string {
    return f"INT:{x}";
}

overload fn format_item(s: string) -> string {
    return f"STR:{s}";
}

multimethod fn format_item(b: bool) -> string {
    return f"BOOL:{b}";
}

assert_eq(format_item(100), "INT:100", "T1_fn_overload_english_int");
assert_eq(format_item("Namaste"), "STR:Namaste", "T1_fn_overload_english_str");
assert_eq(format_item(han), "BOOL:true", "T1_fn_overload_english_bool");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 2: Operator Overloading (Binary Arithmetic)
// ------------------------------------------------------------------------------
biradari Bindu {
    jugaad shuru(x: ank, y: ank) {
        khud.x = x;
        khud.y = y;
    }

    tantrik + (other: Bindu) -> Bindu {
        ye_le Bindu(khud.x + other.x, khud.y + other.y);
    }

    tantrik - (other: Bindu) -> Bindu {
        ye_le Bindu(khud.x - other.x, khud.y - other.y);
    }

    tantrik * (factor: ank) -> Bindu {
        ye_le Bindu(khud.x * factor, khud.y * factor);
    }

    tantrik == (other: Bindu) -> sach {
        ye_le khud.x == other.x aur khud.y == other.y;
    }

    tantrik - () -> Bindu {
        ye_le Bindu(-khud.x, -khud.y);
    }

    jugaad __dikha__() -> bol {
        ye_le f"Bindu({khud.x},{khud.y})";
    }
}

pakad p1 = Bindu(10, 20);
pakad p2 = Bindu(30, 40);

pakad p_sum = p1 + p2;
assert_eq(p_sum.x, 40, "T1_op_overload_add_x");
assert_eq(p_sum.y, 60, "T1_op_overload_add_y");

pakad p_diff = p2 - p1;
assert_eq(p_diff.x, 20, "T1_op_overload_sub_x");
assert_eq(p_diff.y, 20, "T1_op_overload_sub_y");

pakad p_scaled = p1 * 3;
assert_eq(p_scaled.x, 30, "T1_op_overload_mul_x");
assert_eq(p_scaled.y, 60, "T1_op_overload_mul_y");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 2: Operator Overloading (Comparison & Unary)
// ------------------------------------------------------------------------------
pakad p3 = Bindu(10, 20);
assert_eq(p1 == p3, han, "T1_op_overload_eq_true");
assert_eq(p1 == p2, nhi, "T1_op_overload_eq_false");
assert_eq(p1 != p2, han, "T1_op_overload_neq_derived");

pakad p_neg = -p1;
assert_eq(p_neg.x, -10, "T1_op_overload_unary_neg_x");
assert_eq(p_neg.y, -20, "T1_op_overload_unary_neg_y");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 2: Operator Overloading (Indexing Read & Write)
// ------------------------------------------------------------------------------
biradari SuperDabba {
    jugaad shuru() {
        khud.data = [0, 0, 0, 0];
    }

    tantrik [](idx: ank) {
        ye_le khud.data[idx];
    }

    tantrik []=(idx: ank, val) {
        khud.data[idx] = val;
    }
}

pakad dabba = SuperDabba();
dabba[1] = 42;
dabba[3] = 99;
assert_eq(dabba[1], 42, "T1_op_overload_index_write_read_1");
assert_eq(dabba[3], 99, "T1_op_overload_index_write_read_2");
assert_eq(dabba[0], 0, "T1_op_overload_index_default");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 2: English Operator Overload Syntax (`operator` & `op`)
// ------------------------------------------------------------------------------
class Money {
    fn init(amount: int) {
        this.amount = amount;
    }

    operator + (other: Money) -> Money {
        return Money(this.amount + other.amount);
    }

    op * (factor: int) -> Money {
        return Money(this.amount * factor);
    }

    operator == (other: Money) -> bool {
        return this.amount == other.amount;
    }
}

let m1 = Money(500);
let m2 = Money(250);
let m_total = m1 + m2;
assert_eq(m_total.amount, 750, "T1_op_overload_english_add");
let m_triple = m1 * 3;
assert_eq(m_triple.amount, 1500, "T1_op_overload_english_mul");
assert_eq(m1 == Money(500), han, "T1_op_overload_english_eq");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASES: Numeric Widening & Exact Type Resolution
// ------------------------------------------------------------------------------
bahuroop jugaad scale_factor(n: point) -> bol {
    ye_le "FLOAT_MATCH";
}

bahuroop jugaad scale_factor(n: ank) -> bol {
    ye_le "INT_MATCH";
}

assert_eq(scale_factor(10), "INT_MATCH", "T2_overload_scoring_exact_int");
assert_eq(scale_factor(10.5), "FLOAT_MATCH", "T2_overload_scoring_exact_float");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASES: Overloaded Recursion
// ------------------------------------------------------------------------------
bahuroop jugaad super_calc(n: ank) -> ank {
    dekh n <= 1 { ye_le 1; }
    ye_le n * super_calc(n - 1);
}

bahuroop jugaad super_calc(prefix: bol, n: ank) -> bol {
    ye_le f"{prefix}:{super_calc(n)}";
}

assert_eq(super_calc(5), 120, "T2_overload_recursion_math");
assert_eq(super_calc("FACT", 4), "FACT:24", "T2_overload_recursion_wrapper");

// ------------------------------------------------------------------------------
// TIER 2 - BOUNDARY ERROR: No Matching Overload Caught via Panga/Lafda
// ------------------------------------------------------------------------------
pakad no_match_caught = nhi;
panga {
    // Calling with 4 arguments when max arity is 3
    hisaab(1, 2, 3, 4);
} lafda (err) {
    no_match_caught = han;
    dikha "Caught expected overload arity error:", err;
}
assert_eq(no_match_caught, han, "T2_boundary_err_no_matching_overload_arity");

// ------------------------------------------------------------------------------
// TIER 2 - BOUNDARY ERROR: Operator Type Mismatch Caught via Panga/Lafda
// ------------------------------------------------------------------------------
pakad op_mismatch_caught = nhi;
panga {
    pakad bad_sum = p1 + "InvalidStringOperand";
} lafda (err) {
    op_mismatch_caught = han;
    dikha "Caught expected operator operand mismatch error:", err;
}
assert_eq(op_mismatch_caught, han, "T2_boundary_err_op_operand_mismatch");

dikha "=== All Overloading Tests (Tiers 1 & 2) Completed Successfully! ===";
