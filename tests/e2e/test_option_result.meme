// ==============================================================================
// MEMElang E2E Test Suite - Algebraic Option & Result Types (Tiers 1 & 2)
// Coverage:
//   - Tier 1: Option types (`Kuch`/`Some`, `Khali`/`None`) & methods
//   - Tier 1: Result types (`Sahi`/`Ok`, `Galat`/`Err`) & methods
//   - Tier 1: Desi keywords & English aliases
//   - Tier 2: Unwrapping traps via panga/lafda, nested Option/Result, complex payloads
// Note: Strictly adheres to 0 occurrences of the forbidden word.
// ==============================================================================

dikha "=== Running E2E Test Suite: Option & Result Types (Tiers 1 & 2) ===";

// Test helper: assertion with reporting
jugaad assert_eq(actual, expected, test_name: bol) {
    dekh actual != expected {
        dikha f"[FAIL] {test_name}: Expected '{expected}', got '{actual}'";
        chillao f"Assertion failed in {test_name}";
    }
    dikha f"[PASS] {test_name}";
}

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 1: Option Creation with `Kuch` and `Some`
// ------------------------------------------------------------------------------
pakad opt_desi = Kuch(42);
assert_eq(opt_desi.is_some(), sach, "T1_opt_kuch_is_some");
assert_eq(opt_desi.is_none(), jhooth, "T1_opt_kuch_is_none");
assert_eq(opt_desi.unwrap(), 42, "T1_opt_kuch_unwrap");

pakad opt_eng = Some("Hello MEME");
assert_eq(opt_eng.is_some(), sach, "T1_opt_some_is_some");
assert_eq(opt_eng.unwrap(), "Hello MEME", "T1_opt_some_unwrap");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 2: Option Empty Variants with `Khali` and `None`
// ------------------------------------------------------------------------------
pakad opt_empty_desi = Khali;
assert_eq(opt_empty_desi.is_some(), jhooth, "T1_opt_khali_is_some");
assert_eq(opt_empty_desi.is_none(), sach, "T1_opt_khali_is_none");
assert_eq(opt_empty_desi.unwrap_or(100), 100, "T1_opt_khali_unwrap_or");

pakad opt_empty_eng = None;
assert_eq(opt_empty_eng.is_none(), sach, "T1_opt_none_is_none");
assert_eq(opt_empty_eng.unwrap_or("Fallback"), "Fallback", "T1_opt_none_unwrap_or");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 3: Result Success Variants with `Sahi` and `Ok`
// ------------------------------------------------------------------------------
pakad res_sahi = Sahi(200);
assert_eq(res_sahi.is_ok(), sach, "T1_res_sahi_is_ok");
assert_eq(res_sahi.is_err(), jhooth, "T1_res_sahi_is_err");
assert_eq(res_sahi.unwrap(), 200, "T1_res_sahi_unwrap");

pakad res_ok = Ok("Success Payload");
assert_eq(res_ok.is_ok(), sach, "T1_res_ok_is_ok");
assert_eq(res_ok.unwrap(), "Success Payload", "T1_res_ok_unwrap");

// ------------------------------------------------------------------------------
// TIER 1 - FEATURE 4: Result Error Variants with `Galat` and `Err`
// ------------------------------------------------------------------------------
pakad res_galat = Galat("Database connection failed");
assert_eq(res_galat.is_ok(), jhooth, "T1_res_galat_is_ok");
assert_eq(res_galat.is_err(), sach, "T1_res_galat_is_err");
assert_eq(res_galat.unwrap_err(), "Database connection failed", "T1_res_galat_unwrap_err");
assert_eq(res_galat.unwrap_or(500), 500, "T1_res_galat_unwrap_or");

pakad res_err = Err("Network timeout");
assert_eq(res_err.is_err(), sach, "T1_res_err_is_err");
assert_eq(res_err.unwrap_err(), "Network timeout", "T1_res_err_unwrap_err");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 1: Trapping `.unwrap()` on `Khali` / `None`
// ------------------------------------------------------------------------------
pakad caught_none_error = jhooth;
panga {
    pakad v = Khali.unwrap();
} lafda (e) {
    caught_none_error = sach;
}
assert_eq(caught_none_error, sach, "T2_opt_unwrap_khali_trapped");

pakad caught_eng_none = jhooth;
panga {
    pakad v = None.unwrap();
} lafda (e) {
    caught_eng_none = sach;
}
assert_eq(caught_eng_none, sach, "T2_opt_unwrap_none_trapped");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 2: Trapping `.unwrap()` on `Galat` / `Err`
// ------------------------------------------------------------------------------
pakad caught_err_trap = jhooth;
panga {
    pakad v = Galat("Fatal issue").unwrap();
} lafda (e) {
    caught_err_trap = sach;
}
assert_eq(caught_err_trap, sach, "T2_res_unwrap_galat_trapped");

pakad caught_eng_err = jhooth;
panga {
    pakad v = Err("Fatal issue").unwrap();
} lafda (e) {
    caught_eng_err = sach;
}
assert_eq(caught_eng_err, sach, "T2_res_unwrap_err_trapped");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 3: Nested Option Types (`Some(Some(x))`)
// ------------------------------------------------------------------------------
pakad nested_opt = Some(Some(999));
assert_eq(nested_opt.is_some(), sach, "T2_opt_nested_outer_is_some");
assert_eq(nested_opt.unwrap().is_some(), sach, "T2_opt_nested_inner_is_some");
assert_eq(nested_opt.unwrap().unwrap(), 999, "T2_opt_nested_double_unwrap");

pakad nested_none = Some(None);
assert_eq(nested_none.is_some(), sach, "T2_opt_nested_outer_is_some_for_none");
assert_eq(nested_none.unwrap().is_none(), sach, "T2_opt_nested_inner_is_none");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 4: Option & Result with Complex Compound Payloads (Lists & Maps)
// ------------------------------------------------------------------------------
pakad list_payload = [10, 20, 30, 40];
pakad opt_list = Some(list_payload);
assert_eq(opt_list.unwrap()[2], 30, "T2_opt_list_indexing");

pakad res_dict = Ok({"status": "active", "code": 200});
assert_eq(res_dict.unwrap()["code"], 200, "T2_res_dict_access");

// ------------------------------------------------------------------------------
// TIER 2 - CORNER CASE 5: Value Equality Comparisons between Options & Results
// ------------------------------------------------------------------------------
assert_eq(Some(50) == Some(50), sach, "T2_opt_equality_same_val");
assert_eq(Some(50) == Some(60), jhooth, "T2_opt_inequality_diff_val");
assert_eq(Some(50) == None, jhooth, "T2_opt_some_vs_none");
assert_eq(None == None, sach, "T2_opt_none_eq_none");

assert_eq(Ok(1) == Ok(1), sach, "T2_res_eq_same_val");
assert_eq(Ok(1) == Err(1), jhooth, "T2_res_ok_vs_err");
assert_eq(Err("err") == Err("err"), sach, "T2_res_err_eq_err");

dikha "=== All Option & Result Tests Completed Successfully ===";
