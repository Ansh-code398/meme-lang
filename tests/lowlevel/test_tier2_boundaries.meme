// ==============================================================================
// MEMElang Low-Level E2E Test Suite - Tier 2: Boundary & Corner Cases
// Authoritative Source: TEST_INFRA.md, PROJECT.md, and Explorer 2 Report
//
// Coverage:
//   - Zero-length and negative-size buffer allocation
//   - Out-of-bounds indexing and negative index wrapping
//   - Exact boundary vs boundary overflow for typed endian I/O
//   - Subscript write range validation vs write_u8 masking
//   - Max 32-bit integer limits (0xFFFFFFFF)
//   - Slicing boundary clamps and mutation independence
//   - Bitwise shift boundary counts (0, 31, 32, 64) and negative shift guard
//   - Negative integer two's complement bitwise masking
// Note: Strict zero tolerance for forbidden words repository-wide.
// ==============================================================================

dikha "=== Running Low-Level Tier 2 Boundaries Test Suite ===";

// Test helper: Assert equality
jugaad check_eq(actual, expected, test_name: bol) {
    dekh actual != expected {
        dikha f"[FAIL] {test_name}: Expected '{expected}', got '{actual}'";
        chillao f"Assertion failed in {test_name}";
    }
    dikha f"[PASS] {test_name}";
}

// Test helper: Assert boolean condition
jugaad check_true(cond: sach, test_name: bol) {
    dekh !cond {
        dikha f"[FAIL] {test_name}: Expected true, got false";
        chillao f"Assertion failed in {test_name}";
    }
    dikha f"[PASS] {test_name}";
}

// ------------------------------------------------------------------------------
// F2 Boundaries: Zero & Negative Length Buffer Allocation
// ------------------------------------------------------------------------------
pakad b_zero = bytes(0);
check_eq(b_zero.length(), 0, "T2_bytes_zero_length");
check_eq(b_zero.to_hex(), "", "T2_bytes_zero_to_hex");

pakad b_neg = bytes(-5);
check_eq(b_neg.length(), 0, "T2_bytes_negative_alloc_safe");

// ------------------------------------------------------------------------------
// F2 Boundaries: Negative Indexing & Boundary Subscripts
// ------------------------------------------------------------------------------
pakad b_idx = bytes([10, 20, 30]);
check_eq(b_idx[-1], 30, "T2_subscript_negative_last");
check_eq(b_idx[-2], 20, "T2_subscript_negative_penultimate");
check_eq(b_idx[-3], 10, "T2_subscript_negative_first");

// Subscript out of bounds positive
pakad caught_oob_pos = jhooth;
try {
    pakad v = b_idx[3];
} catch (e) {
    caught_oob_pos = sach;
}
check_true(caught_oob_pos, "T2_subscript_oob_pos_throws");

// Subscript out of bounds negative
pakad caught_oob_neg = jhooth;
try {
    pakad v = b_idx[-4];
} catch (e) {
    caught_oob_neg = sach;
}
check_true(caught_oob_neg, "T2_subscript_oob_neg_throws");

// Subscript assign out of bounds
pakad caught_assign_oob = jhooth;
try {
    b_idx[10] = 50;
} catch (e) {
    caught_assign_oob = sach;
}
check_true(caught_assign_oob, "T2_subscript_assign_oob_throws");

// Subscript assign boundary values: 0 and 255
b_idx[0] = 0;
check_eq(b_idx[0], 0, "T2_subscript_assign_val_0");
b_idx[0] = 255;
check_eq(b_idx[0], 255, "T2_subscript_assign_val_255");

// ------------------------------------------------------------------------------
// F2 Boundaries: write_u8 Masking vs Exact Bounds
// ------------------------------------------------------------------------------
pakad b_mask = bytes(2);
b_mask.write_u8(0, 256);
check_eq(b_mask.read_u8(0), 0, "T2_write_u8_mask_256_to_0");

b_mask.write_u8(1, -1);
check_eq(b_mask.read_u8(1), 255, "T2_write_u8_mask_neg1_to_255");

// write_u8 out of bounds throws
pakad caught_u8_oob = jhooth;
try {
    b_mask.write_u8(2, 42);
} catch (e) {
    caught_u8_oob = sach;
}
check_true(caught_u8_oob, "T2_write_u8_oob_throws");

// ------------------------------------------------------------------------------
// F2 Boundaries: Endian Multi-byte Exact Boundary vs Overflow
// ------------------------------------------------------------------------------
pakad b_end = bytes(4);
// Exact boundary write for u16: offset 2 on 4-byte buffer -> fills bytes 2,3
b_end.write_u16_be(2, 43605); // 0xAA55
check_eq(b_end.read_u16_be(2), 43605, "T2_u16_be_exact_boundary_roundtrip");

// Boundary overflow: offset 3 + 2 = 5 > 4 bytes
pakad caught_u16_ovf = jhooth;
try {
    b_end.read_u16_be(3);
} catch (e) {
    caught_u16_ovf = sach;
}
check_true(caught_u16_ovf, "T2_u16_be_boundary_overflow_throws");

// Exact boundary write for u32: offset 0 on 4-byte buffer
b_end.write_u32_be(0, 4294967295); // 0xFFFFFFFF
check_eq(b_end.read_u32_be(0), 4294967295, "T2_u32_be_max_value_roundtrip");
check_eq(b_end.to_hex(), "ffffffff", "T2_u32_be_max_hex");

// Boundary overflow: offset 1 + 4 = 5 > 4 bytes
pakad caught_u32_ovf = jhooth;
try {
    b_end.read_u32_be(1);
} catch (e) {
    caught_u32_ovf = sach;
}
check_true(caught_u32_ovf, "T2_u32_be_boundary_overflow_throws");

// ------------------------------------------------------------------------------
// F2 Boundaries: Slicing Boundary Limits and Mutation Independence
// ------------------------------------------------------------------------------
pakad b_slice_src = bytes([1, 2, 3, 4, 5]);

// start == end produces empty slice
pakad s_empty = b_slice_src.slice(2, 2);
check_eq(s_empty.length(), 0, "T2_slice_start_eq_end_empty");

// start > end produces empty slice
pakad s_inverted = b_slice_src.slice(4, 2);
check_eq(s_inverted.length(), 0, "T2_slice_start_gt_end_empty");

// end > length clamps to length
pakad s_clamped = b_slice_src.slice(0, 100);
check_eq(s_clamped.length(), 5, "T2_slice_clamp_upper_length");
check_eq(s_clamped[4], 5, "T2_slice_clamp_upper_val");

// negative slice indices: slice(-3, -1) -> [3, 4]
pakad s_neg = b_slice_src.slice(-3, -1);
check_eq(s_neg.length(), 2, "T2_slice_negative_indices_length");
check_eq(s_neg[0], 3, "T2_slice_negative_indices_elem0");
check_eq(s_neg[1], 4, "T2_slice_negative_indices_elem1");

// Mutation independence: changing slice must NOT change original
s_neg[0] = 99;
check_eq(b_slice_src[2], 3, "T2_slice_mutation_independence");

// ------------------------------------------------------------------------------
// F2 Boundaries: Large Buffer Allocation (64KB)
// ------------------------------------------------------------------------------
pakad b_large = bytes(65536);
check_eq(b_large.length(), 65536, "T2_large_buffer_alloc_64k");
b_large.write_u16_be(65534, 12345);
check_eq(b_large.read_u16_be(65534), 12345, "T2_large_buffer_tail_access");

// ------------------------------------------------------------------------------
// F3 Boundaries: Bitwise Shift Boundaries and Overflow Guards
// ------------------------------------------------------------------------------
check_eq(bshl(1, 0), 1, "T2_bitwise_bshl_zero_identity");
check_eq(bshr(42, 0), 42, "T2_bitwise_bshr_zero_identity");

check_eq(bshl(1, 31), 2147483648, "T2_bitwise_bshl_31_boundary");
check_eq(bshl(1, 32), 4294967296, "T2_bitwise_bshl_32_boundary");

// Shift by >= 64 bits safe guard (returns 0, avoids undefined behavior)
check_eq(bshl(1, 64), 0, "T2_bitwise_bshl_64_overflow_zero");
check_eq(bshr(12345, 64), 0, "T2_bitwise_bshr_64_overflow_zero");

// Negative shift count: either throws or safely clamps to 0
pakad caught_bshl_neg = jhooth;
try {
    pakad v = bshl(1, -1);
    dekh v == 0 {
        caught_bshl_neg = sach;
    }
} catch (e) {
    caught_bshl_neg = sach;
}
check_true(caught_bshl_neg, "T2_bitwise_bshl_neg_count_throws");

pakad caught_bshr_neg = jhooth;
try {
    pakad v = bshr(1, -1);
    dekh v == 0 || v == -1 {
        caught_bshr_neg = sach;
    }
} catch (e) {
    caught_bshr_neg = sach;
}
check_true(caught_bshr_neg, "T2_bitwise_bshr_neg_count_throws");

// ------------------------------------------------------------------------------
// F3 Boundaries: Bitwise Identities & Two's Complement
// ------------------------------------------------------------------------------
check_eq(band(12345, 0), 0, "T2_bitwise_band_zero_identity");
check_eq(bor(0, 0), 0, "T2_bitwise_bor_zero_identity");
check_eq(bxor(42, 0), 42, "T2_bitwise_bxor_zero_identity");
check_eq(bxor(42, 42), 0, "T2_bitwise_bxor_self_zero");
check_eq(band(-1, 255), 255, "T2_bitwise_band_neg1_mask");
check_eq(bor(0, 255), 255, "T2_bitwise_bor_zero_mask");

dikha "=== Low-Level Tier 2 Boundaries: All Tests Passed ===";
