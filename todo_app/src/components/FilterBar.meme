// FilterBar.meme - Filter tabs (Sab, Baaki, Poora)
kaam FilterBar(props) {
    pakad filter = props.filter;
    pakad setFilter = props.onFilterChange;

    de (
        <div class="flex items-center space-x-2 mt-4 pt-4 border-t border-slate-800">
            <button
                class={filter == "sab" ? "px-3 py-1 bg-amber-500 text-slate-950 font-bold rounded-lg text-xs" : "px-3 py-1 bg-slate-800 text-slate-400 hover:text-white rounded-lg text-xs"}
                onClick={() => setFilter("sab")}
            >
                {"Sab (" + props.totalCount + ")"}
            </button>
            <button
                class={filter == "baaki" ? "px-3 py-1 bg-amber-500 text-slate-950 font-bold rounded-lg text-xs" : "px-3 py-1 bg-slate-800 text-slate-400 hover:text-white rounded-lg text-xs"}
                onClick={() => setFilter("baaki")}
            >
                {"Baaki (" + props.activeCount + ")"}
            </button>
            <button
                class={filter == "poora" ? "px-3 py-1 bg-amber-500 text-slate-950 font-bold rounded-lg text-xs" : "px-3 py-1 bg-slate-800 text-slate-400 hover:text-white rounded-lg text-xs"}
                onClick={() => setFilter("poora")}
            >
                {"Poora (" + props.completedCount + ")"}
            </button>
        </div>
    );
}
