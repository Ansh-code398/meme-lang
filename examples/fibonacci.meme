// Recursive Fibonacci in MEMElang (Clean Python/JS-style OOP Edition)
function fib(n) {
    if (n <= 0) {
        return 0;
    }
    else if (n == 1) {
        return 1;
    }
    return fib(n - 1) + fib(n - 2);
}

print("--- Fibonacci Numbers (0 to 8) ---");
for i in 0 to 8 {
    print("fib(" + i + ") =", fib(i));
}
