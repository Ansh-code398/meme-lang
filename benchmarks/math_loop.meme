// Benchmark: Modular Math Loop in MEMElang
bula "samay" jaise samay;

jugaad bench_math_loop(n) {
    pakad a = 0;
    pakad b = 1;
    pakad i = 0;
    pakad MOD = 1000000007;
    jabtak i < n {
        pakad c = (a * 3 + b / 2 + i) % MOD;
        a = b;
        b = c;
        i = i + 1;
    }
    ye_le a;
}

pakad start = samay.ab();
pakad result = bench_math_loop(200000);
pakad elapsed = (samay.ab() - start) * 1000.0;

dikha f"MEMElang | Math Loop 200000 | Result: {result} | Time: {point_wala(elapsed)}ms";
