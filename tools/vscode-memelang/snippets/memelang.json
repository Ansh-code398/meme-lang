{
  "Function (jugaad)": {
    "prefix": "jugaad",
    "body": [
      "jugaad ${1:naam}(${2:params}) {",
      "\t${0:// logic yahan}",
      "\tye_le ${3:result};",
      "}"
    ],
    "description": "Define a MEMElang function (jugaad)"
  },
  "Function (kaam)": {
    "prefix": "kaam",
    "body": [
      "kaam ${1:naam}(${2:params}) {",
      "\t${0}",
      "\tye_le ${3:result};",
      "}"
    ],
    "description": "Define a WhatsApp Hinglish function (kaam)"
  },
  "Async Function (async kaam)": {
    "prefix": "async_kaam",
    "body": [
      "async kaam ${1:fetchData}(${2:url}) {",
      "\tres = sabar fetch(${2:url});",
      "\tdata = res.json();",
      "\tye_le data;",
      "}"
    ],
    "description": "Define an asynchronous function (async kaam / async jugaad)"
  },
  "Arrow Lambda": {
    "prefix": ["lambda", "arrow", "=>"],
    "body": [
      "(${1:x}) => ${2:x * 2}"
    ],
    "description": "Short single-expression arrow lambda"
  },
  "Arrow Lambda Block": {
    "prefix": "lambdablock",
    "body": [
      "(${1:a, b}) => {",
      "\t${0}",
      "\tye_le ${2:res};",
      "}"
    ],
    "description": "Multi-statement arrow lambda block"
  },
  "Class (biradari)": {
    "prefix": "biradari",
    "body": [
      "biradari ${1:Naam} {",
      "\tjugaad shuru(${2:params}) {",
      "\t\tkhud.${3:prop} = ${2:params};",
      "\t}",
      "",
      "\t${0}",
      "}"
    ],
    "description": "Define a MEMElang class (biradari)"
  },
  "Subclass (nepo)": {
    "prefix": "nepo",
    "body": [
      "biradari ${1:Beta} nepo ${2:Baap} {",
      "\tjugaad shuru(${3:params}) {",
      "\t\tse.shuru(${3:params});",
      "\t}",
      "}"
    ],
    "description": "Inherit from a superclass (nepo inheritance)"
  },
  "Tantrik Method (__jod__)": {
    "prefix": "__jod__",
    "body": [
      "jugaad __jod__(other) {",
      "\tye_le ${1:khud.val + other.val};",
      "}"
    ],
    "description": "Tantrik operator overloading for '+'"
  },
  "Tantrik Display (__dikha__)": {
    "prefix": "__dikha__",
    "body": [
      "jugaad __dikha__() {",
      "\tye_le f\"${1:Object}({khud.${2:prop}})\";",
      "}"
    ],
    "description": "Tantrik string representation for printing and f-strings"
  },
  "Tantrik Comparison (__barabar__ & __chota__)": {
    "prefix": "tantrik_cmp",
    "body": [
      "jugaad __barabar__(other) {",
      "\tye_le khud.${1:prop} == other.${1:prop};",
      "}",
      "",
      "jugaad __chota__(other) {",
      "\tye_le khud.${1:prop} < other.${1:prop};",
      "}"
    ],
    "description": "Tantrik comparison operators ('==' and '<', auto-derives '!=', '>', '<=', '>=')"
  },
  "Tantrik Indexing (__la__ & __daal__)": {
    "prefix": "tantrik_index",
    "body": [
      "jugaad __la__(key) {",
      "\tye_le khud.data[key];",
      "}",
      "",
      "jugaad __daal__(key, val) {",
      "\tkhud.data[key] = val;",
      "}"
    ],
    "description": "Tantrik bracket indexing read and write (obj[k] and obj[k] = v)"
  },
  "If-Else (dekh-warna)": {
    "prefix": "dekh",
    "body": [
      "dekh ${1:condition} {",
      "\t${2:// true logic}",
      "} warna {",
      "\t${0:// false logic}",
      "}"
    ],
    "description": "Conditional if-else statement (dekh / warna)"
  },
  "If-Else (agar-varnah)": {
    "prefix": "agar",
    "body": [
      "agar ${1:condition} {",
      "\t${2:// true logic}",
      "} varnah {",
      "\t${0:// false logic}",
      "}"
    ],
    "description": "WhatsApp Hinglish if-else (agar / varnah)"
  },
  "While Loop (jabtak)": {
    "prefix": "jabtak",
    "body": [
      "jabtak ${1:condition} {",
      "\t${0}",
      "}"
    ],
    "description": "While loop (jabtak)"
  },
  "For Loop (ghoom)": {
    "prefix": "ghoom",
    "body": [
      "ghoom pakad ${1:item} mein ${2:collection} {",
      "\t${0}",
      "}"
    ],
    "description": "For-in iteration loop (ghoom)"
  },
  "For-Each Loop (har)": {
    "prefix": "har",
    "body": [
      "har ${1:item} mein ${2:collection} {",
      "\t${0}",
      "}"
    ],
    "description": "WhatsApp Hinglish for-each loop (har x mein arr)"
  },
  "Filter (chhaan)": {
    "prefix": "chhaan",
    "body": [
      ".chhaan(${1:item} => ${2:item > 0})"
    ],
    "description": "Filter collection elements"
  },
  "Map (sab_pe)": {
    "prefix": "sab_pe",
    "body": [
      ".sab_pe(${1:item} => ${2:item * 2})"
    ],
    "description": "Transform collection elements"
  },
  "Reduce (nichod)": {
    "prefix": "nichod",
    "body": [
      ".nichod((${1:acc}, ${2:item}) => ${3:acc + item}, ${4:0})"
    ],
    "description": "Fold/reduce collection into a single value"
  },
  "Sort (line_mein)": {
    "prefix": "line_mein",
    "body": [
      ".line_mein()"
    ],
    "description": "Sort list in-place"
  },
  "Try-Catch (panga-lafda)": {
    "prefix": "panga",
    "body": [
      "panga {",
      "\t${1:// risky code}",
      "} lafda (err) {",
      "\tdikha f\"Lafda ho gaya: {err.baat} (Type: {err.kism} line {err.line})\";",
      "} pakka {",
      "\t${0:// cleanup}",
      "}"
    ],
    "description": "Structured exception handling block (panga / lafda / pakka)"
  },
  "Pattern Match (jaanch)": {
    "prefix": "jaanch",
    "body": [
      "jaanch ${1:value} {",
      "\t${2:case1} => {",
      "\t\t${3}",
      "\t},",
      "\tbaaki => {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Pattern matching switch statement"
  },
  "Print (dikha)": {
    "prefix": "dikha",
    "body": [
      "dikha ${1:\"message\"};"
    ],
    "description": "Print to console"
  },
  "F-String": {
    "prefix": "fstring",
    "body": [
      "f\"${1:Hello} {${2:variable}}\""
    ],
    "description": "F-String interpolation"
  },
  "Array Destructure": {
    "prefix": "destruct_arr",
    "body": [
      "pakad [${1:a}, ${2:b}, *${3:baaki}] = ${4:arr};"
    ],
    "description": "Unpack array into variables with variadic rest"
  },
  "Map Destructure": {
    "prefix": "destruct_map",
    "body": [
      "pakad {${1:key1}, ${2:key2}} = ${3:map_or_obj};"
    ],
    "description": "Unpack map or object fields into variables"
  },
  "Express HTTP Server": {
    "prefix": "express_server",
    "body": [
      "app = express();",
      "app.use(express.json());",
      "app.use(express.cors());",
      "",
      "app.get(\"/\", (req, res) => {",
      "\tres.json({ \"message\": \"Swag se swagat hai!\", \"status\": 200 });",
      "});",
      "",
      "app.listen(${1:3000}, () => {",
      "\tdikha f\"🚀 Express server active at http://localhost:${1:3000}\";",
      "});"
    ],
    "description": "Create an Express-compatible HTTP Server"
  },
  "Elysia Type-Safe Server": {
    "prefix": "elysia_server",
    "body": [
      "app = elysia();",
      "",
      "app.state(\"counter\", 0);",
      "app.derive((ctx) => {",
      "\tctx.store.counter = ctx.store.counter + 1;",
      "\tye_le { \"client\": ctx.ip };",
      "});",
      "",
      "${1:UserSchema} = {",
      "\t\"body\": t.Object({",
      "\t\t\"name\": t.String({ \"minLength\": 2 }),",
      "\t\t\"age\": t.Integer({ \"minimum\": 18 })",
      "\t})",
      "};",
      "",
      "app.post(\"/users\", (ctx) => {",
      "\tye_le {",
      "\t\t\"success\": han,",
      "\t\t\"data\": ctx.body,",
      "\t\t\"reqNumber\": ctx.store.counter",
      "\t};",
      "}, ${1:UserSchema});",
      "",
      "app.listen(${2:3000}, () => {",
      "\tdikha f\"⚡ Elysia server running at http://localhost:${2:3000}\";",
      "});"
    ],
    "description": "Create an Elysia-style type-safe server with schema validation"
  },
  "TypeBox Schema Object": {
    "prefix": "schema_object",
    "body": [
      "t.Object({",
      "\t\"${1:id}\": t.Integer(),",
      "\t\"${2:name}\": t.String({ \"minLength\": 1 }),",
      "\t\"${3:email}\": t.String(),",
      "\t\"${4:isAdmin}\": t.Optional(t.Boolean())",
      "})"
    ],
    "description": "TypeBox Schema Object validator definition"
  },
  "HTTP Fetch Call": {
    "prefix": "fetch_api",
    "body": [
      "res = sabar fetch(\"${1:https://api.example.com/data}\", {",
      "\t\"method\": \"${2:GET}\",",
      "\t\"headers\": { \"Accept\": \"application/json\" }",
      "});",
      "",
      "agar res.ok {",
      "\tdata = res.json();",
      "\tdikha data;",
      "}"
    ],
    "description": "Send asynchronous HTTP fetch request"
  },
  "Thread Spawn (dhaga)": {
    "prefix": "thread_spawn",
    "body": [
      "t = dhaga.chala((${1:param}) => {",
      "\t${0}",
      "\tye_le \"done\";",
      "}, ${2:arg});",
      "",
      "result = t.jod();"
    ],
    "description": "Spawn an OS hardware thread with dhaga.chala"
  },
  "Go-Style Channel (naali)": {
    "prefix": "channel",
    "body": [
      "ch = dhaga.naali();",
      "dhaga.chala(() => {",
      "\tch.bhej(\"Message from thread\");",
      "});",
      "msg = ch.le();",
      "dikha msg;"
    ],
    "description": "Thread-safe communication channel (naali)"
  },
  "Multi-Processing Map (kaamgar)": {
    "prefix": "mp_map",
    "body": [
      "results = kaamgar.sab_pe((x) => x * x, ${1:dataList}, ${2:4});",
      "dikha results;"
    ],
    "description": "Parallel CPU multi-processing map (kaamgar.sab_pe)"
  },
  "File Read / Write": {
    "prefix": "file_ops",
    "body": [
      "content = file.padh(\"${1:./input.txt}\");",
      "file.likh(\"${2:./output.txt}\", content + \"\\nUpdated\");"
    ],
    "description": "Read and write files with file / fs module"
  },
  "React Declarative Component": {
    "prefix": "react_component",
    "body": [
      "biradari ${1:MyComponent} nepo Component {",
      "\tjugaad shuru(props) {",
      "\t\tse.shuru(props);",
      "\t}",
      "",
      "\tjugaad render() {",
      "\t\tpakad [count, setCount] = useState(0);",
      "",
      "\t\tye_le VStack({",
      "\t\t\t\"class\": \"p-6 bg-slate-900 text-white rounded-xl shadow-lg\",",
      "\t\t\t\"children\": [",
      "\t\t\t\tText({ value: f\"Counter: {count}\", class: \"text-2xl font-bold\" }),",
      "\t\t\t\tButton({ title: \"Increment\", onClick: () => setCount(count + 1) })",
      "\t\t\t]",
      "\t\t});",
      "\t}",
      "}"
    ],
    "description": "Declarative UI Component with hooks and Tailwind v4 engine"
  },
  "useState Hook": {
    "prefix": "use_state",
    "body": [
      "pakad [${1:state}, set${1/(.*)/${1:/capitalize}/}] = useState(${2:initialValue});"
    ],
    "description": "React-style useState hook"
  },
  "Unit Test Suite": {
    "prefix": "test_suite",
    "body": [
      "test.describe(\"${1:Feature}\", () => {",
      "\ttest.it(\"${2:should succeed}\", () => {",
      "\t\ttest.assert_eq(${3:actual}, ${4:expected});",
      "\t});",
      "});"
    ],
    "description": "Create a unit test suite with test module"
  }
}