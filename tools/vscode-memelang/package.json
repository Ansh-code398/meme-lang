{
  "name": "memelang",
  "displayName": "MEMElang Language Support",
  "description": "Syntax Highlighting, Context-Aware IntelliSense, Snippets, Hover Docs & Signature Help for MEMElang (.meme) with Express, Elysia, Concurrency, and React UI support",
  "version": "2.0.0",
  "publisher": "memelang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ansh-code398/meme-lang.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "memelang",
    "meme",
    "desi",
    "hindi",
    "pythonic",
    "express",
    "elysia"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:memelang"
  ],
  "contributes": {
    "languages": [
      {
        "id": "memelang",
        "aliases": [
          "MEMElang",
          "memelang",
          "meme"
        ],
        "extensions": [
          ".meme"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "memelang",
        "scopeName": "source.meme",
        "path": "./syntaxes/memelang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "memelang",
        "path": "./snippets/memelang.json"
      }
    ]
  }
}
