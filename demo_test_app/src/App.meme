// demo_test_app - MEMElang Native React App
kaam Counter() {
    [count, setCount] = useState(0);
    de (
        <div class="p-6 bg-slate-900 rounded-2xl border border-slate-700 max-w-sm mx-auto shadow-xl">
            <h1 class="text-2xl font-bold text-white mb-2">☕ demo_test_app</h1>
            <p class="text-slate-400 mb-4">Zero-WebView GPU Native UI with Reactivity</p>
            <div class="flex items-center space-x-4 mb-4">
                <span class="text-3xl font-extrabold text-amber-400">{count}</span>
                <button
                    class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold rounded-lg transition"
                    onClick={() => setCount(c => c + 1)}
                >
                    + Chai Ghusa
                </button>
            </div>
        </div>
    );
}

kaam App() {
    de (
        <Router>
            <Route path="/" element={<Counter />} />
        </Router>
    );
}

ui.mount(<App />);
