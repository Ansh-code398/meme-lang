// apps/chat/desktop/src/ChatEgui.meme
// Pure Native Desktop GUI (egui equivalent) in MEMElang
// ZERO dev server • ZERO HTTP ports • ZERO Chrome tabs • Pure Native Cocoa Window

bula "egui";

kaam main() {
    pakad defaultMessages = [
        "Connected to MEME-CHAT Cluster at 127.0.0.1:9099",
        "@alice: Hello from native egui in MEMElang!",
        "@bob: Notice that no web server or Chrome tab is running.",
        "@charlie: This renders directly into a native macOS Cocoa window at 60 FPS."
    ];

    [messages, setMessages] = useState(defaultMessages);
    [inputMsg, setInputMsg] = useState("");
    [pingCount, setPingCount] = useState(0);

    kaam onSend() {
        agar (inputMsg != "") {
            setMessages([...messages, "@you: " + inputMsg]);
            setInputMsg("");
        }
    }

    kaam onPing() {
        pakad next = pingCount + 1;
        setPingCount(next);
        setMessages([...messages, "⚡ Ping probe #" + next + " ACK (48 us latency)"]);
    }

    pakad screen = (
        <div class="p-6 bg-slate-950 min-h-screen flex flex-col gap-4">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
                    <h1 class="text-lg font-bold text-white">⚡ MEME-egui Native Desktop</h1>
                    <span class="text-xs px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-mono">
                        60 FPS Native Cocoa
                    </span>
                </div>
                <div class="flex items-center gap-2">
                    <button 
                        class="px-3 py-1 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold rounded-lg text-xs"
                        onClick={onPing}
                    >
                        {"⚡ Ping (" + pingCount + ")"}
                    </button>
                </div>
            </div>

            <div class="flex-1 bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col gap-2 min-h-[300px]">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider border-b border-slate-800 pb-2">
                    {"Chat Messages (" + messages.lambai() + ")"}
                </div>
                <div class="space-y-2 flex-1 overflow-y-auto">
                    {messages.map(m => (
                        <div class="p-2.5 bg-slate-800/80 rounded-lg text-xs text-slate-200 border border-slate-700/50">
                            {m}
                        </div>
                    ))}
                </div>
            </div>

            <div class="flex items-center gap-2 pt-2 border-t border-slate-800">
                <input
                    class="flex-1 px-4 py-2 bg-slate-800 border border-slate-700 rounded-lg text-white text-xs focus:outline-none"
                    placeholder="Type message in immediate mode..."
                    value={inputMsg}
                    onChange={(e) => setInputMsg(e.target.value)}
                />
                <button
                    class="px-4 py-2 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold rounded-lg text-xs"
                    onClick={onSend}
                >
                    Send
                </button>
            </div>
        </div>
    );

    egui.mount(screen);
    egui.show("MEME-egui Realtime Chat");
}

main();
